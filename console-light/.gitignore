# Console Light — source only. Deps, runtime state, and generated proofs stay out.

# Node deps
ui/node_modules/

# Build outputs
ui/dist/
ui/.vite/
ui/coverage/

# Playwright artifacts (regenerable from specs)
ui/test-results/
ui/playwright-report/
ui/blob-report/
ui/.playwright/

# Runtime state + nested git repos (governance-repo, ci-mirror have their own .git/remotes)
var/

# Generated proof artifacts (screenshots, CI logs — regenerated by scripts/prove-*.sh)
evidence/

# Logs / env
*.log
.env
.env.*
