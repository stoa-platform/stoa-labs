#!/usr/bin/env bash
# Collecte de la carto. LECTURE SEULE sur la production.
# Regle (spec D9) : un echec silencieux produit PIRE que rien — une carto
# perimee qui a l'air fraiche. On alerte donc systematiquement, et on laisse
# en place la derniere carto valide.
set -uo pipefail
# Le script se place lui-meme dans son repertoire d'installation : toute
# invocation (cron, appel manuel par chemin absolu, unite systemd,
# diagnostic) trouve le paquet sans dependre d'un `cd` fait par l'appelant.
cd "{{ carto_install_dir }}" || exit 1

export WM_ADMIN_URL={{ carto_env.WM_ADMIN_URL | quote }}
export WM_USER={{ carto_env.WM_USER | quote }}
export WM_PASS={{ carto_env.WM_PASS | quote }}
# Depuis le 2026-07-31, ces trois variables suffisent : le trafic se lit par
# l'API publique de la gateway, plus par son Elasticsearch interne.

# Mode verification (invoque par Ansible en fin de role, `--verify`) : ne
# publie rien, rapporte les compteurs sur la sortie standard, ne touche ni
# au journal d'echec ni a la carto deja publiee. Les identifiants restent
# internes a ce script : Ansible n'a jamais besoin de les repasser via
# `environment:` — ce couplage exposerait WM_PASS en clair dans la trace
# EXEC du plugin de connexion des qu'on relance en -vvv, ce que `no_log` ne
# protege pas (no_log masque le resultat de la tache, pas cette trace-la).
if [ "${1:-}" = "--verify" ]; then
  VERIFY_OUT=$(mktemp -d)
  python3 -m carto.collect --out "$VERIFY_OUT" --dry-run
  status=$?
  rm -rf "$VERIFY_OUT"
  exit "$status"
fi

LOG=$(mktemp)
RENDU_LOCAL=""
# La sortie peut contenir des elements d'infrastructure : elle va dans un
# fichier, jamais sur la sortie standard du planificateur.
#
# L'installation du rendu fait partie de la CONDITION, pas du corps du succes :
# ce script tourne sans `-e`, et un rendu en echec (droits, disque plein)
# apres une collecte reussie sortait en 0, sans alerte ni journal — une
# publication partielle silencieuse, exactement ce que cette enveloppe combat.
# Sa sortie d'erreur va dans le meme journal, pour que l'exploitant voie
# laquelle des deux etapes a lache.
#
# index.html est AUTOPORTANT depuis carto/render/page.py : il n'y a plus de
# `fetch()` cote page, donc plus de version "brute" installable telle quelle
# par un simple `install`. On l'assemble ici avec `python3 -m carto.render`,
# dans un repertoire temporaire jetable — jamais {{ carto_web_root }}
# lui-meme comme `--out` (carto.json et history.json y seraient recopies sur
# eux-memes, ce que `shutil.copyfile` refuse). Ce meme rendu sert ensuite de
# source a la publication Markdown ci-dessous s'il elle est activee : pas de
# second appel a `carto.render` pour la meme collecte.
if python3 -m carto.collect --out {{ carto_web_root }} >"$LOG" 2>&1 \
   && RENDU_LOCAL=$(mktemp -d) \
   && python3 -m carto.render --source {{ carto_web_root }} --out "$RENDU_LOCAL" --message >>"$LOG" 2>&1 \
   && install -m 0644 "$RENDU_LOCAL/index.html" {{ carto_web_root }}/index.html >>"$LOG" 2>&1
then
{% if carto_pages_repo_url %}
  # Publication Markdown dans le depot git dedie. Elle vient APRES la
  # publication locale, jamais avant : la carto du jour doit exister quelque
  # part meme si la forge est injoignable.
  #
  # Son echec est un ECHEC du passage (meme alerte, meme journal) : une
  # publication qui echoue en silence laisserait dans la forge une carto
  # perimee qui a l'air fraiche — exactement ce que cette enveloppe combat.
  # Mais la carto locale, elle, reste publiee : les deux cibles ne se
  # contaminent pas.
  export CARTO_PAGES_REPO_URL={{ carto_pages_repo_url | quote }}
  export CARTO_PAGES_BRANCH={{ carto_pages_branch | quote }}
  export CARTO_PAGES_AUTHOR_NAME={{ carto_pages_author_name | quote }}
  export CARTO_PAGES_AUTHOR_EMAIL={{ carto_pages_author_email | quote }}
  # Le compte de service et son jeton restent INTERNES a ce script, comme les
  # identifiants de la gateway : ce gabarit est pose avec `no_log`, et rien ne
  # les repasse jamais par une sortie Ansible ni par une ligne de commande.
  export CARTO_PAGES_USER={{ carto_pages_user | quote }}
  export CARTO_PAGES_TOKEN={{ carto_pages_token | quote }}

  if ! {{ carto_install_dir }}/publier-markdown.sh --source "$RENDU_LOCAL" >>"$LOG" 2>&1
  then
    rm -rf "$RENDU_LOCAL"
    {{ carto_alert_command }} "publication Markdown de la carto EN ECHEC — la carto locale est a jour, celle du depot git ne l'est pas"
    cp "$LOG" {{ carto_install_dir }}/last-failure.log
    chmod 0600 {{ carto_install_dir }}/last-failure.log
    rm -f "$LOG"
    exit 1
  fi
{% endif %}
  rm -rf "$RENDU_LOCAL"
  rm -f "$LOG"
  # Un passage reussi efface un eventuel journal d'echec precedent : sinon
  # sa seule presence, retrouvee des jours plus tard, ferait croire a une
  # panne en cours alors que tout va bien — un faux signal d'alarme.
  rm -f "{{ carto_install_dir }}/last-failure.log"
  exit 0
fi

rm -rf "${RENDU_LOCAL:-}"
{{ carto_alert_command }} "collecte ou publication de la carto EN ECHEC — la carto publiee date de la veille ou avant"
cp "$LOG" {{ carto_install_dir }}/last-failure.log
chmod 0600 {{ carto_install_dir }}/last-failure.log
rm -f "$LOG"
exit 1
