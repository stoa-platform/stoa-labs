{
  "realm": "stoa-lab",
  "enabled": true,
  "displayName": "STOA Lab — Fédération PoC",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "identityProviders": [
    {
      "alias": "oracle",
      "displayName": "Oracle (mock via Dex)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "keycloak-broker",
        "clientSecret": "keycloak-broker-secret-poc",
        "clientAuthMethod": "client_secret_post",
        "issuer": "http://dex:5556/dex",
        "authorizationUrl": "http://localhost:5556/dex/auth",
        "tokenUrl": "http://dex:5556/dex/token",
        "jwksUrl": "http://dex:5556/dex/keys",
        "userInfoUrl": "http://dex:5556/dex/userinfo",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "syncMode": "FORCE"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "cpi-admin", "description": "Console Light — admin plateforme (tous tenants, tous droits)" },
      { "name": "tenant-admin", "description": "Console Light — fournisseur d'API (édite/publie sur son tenant, approuve les souscriptions)" },
      { "name": "devops", "description": "Console Light — approbateur (approuve les promotions, 4-yeux)" },
      { "name": "viewer", "description": "Console Light — auditeur/lecture seule" }
    ]
  },
  "clients": [
    {
      "clientId": "console-light",
      "name": "STOA Console Light (gouvernance)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "tenant-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "vault-exchange-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vault-exchange",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "stoa-portal",
      "name": "STOA Portal / Backstage",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": { "post.logout.redirect.uris": "*" },
      "protocolMappers": [
        {
          "name": "vault-exchange-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vault-exchange",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "poc-gateways",
      "name": "Gateways (WSO2 / APISIX / webMethods) — token audience",
      "enabled": true,
      "publicClient": false,
      "secret": "poc-gateways-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "gateways-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "poc-gateways",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vault",
      "name": "HashiCorp Vault — cible d'audience (token exchange, chaîne A ADR-077)",
      "description": "Client-ressource : n'émet ni ne consomme de flow OAuth2. Il n'existe que pour que le token exchange standard (RFC 8693) puisse cibler audience=vault ; Vault (auth jwt) exige ensuite bound_audiences=vault.",
      "enabled": true,
      "publicClient": false,
      "secret": "vault-resource-unused-poc",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "vault-exchange",
      "name": "STS token exchange → Vault (délégation identité utilisateur, ADR-077)",
      "description": "Client confidentiel autorisé au token exchange standard (KC 26.2+) : échange le token utilisateur de la Console (aud=vault-exchange) contre un JWT court aud=vault, sub=utilisateur. Aucun flow interactif, aucun service account.",
      "enabled": true,
      "publicClient": false,
      "secret": "vault-exchange-secret-poc",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "tenant-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-poc",
      "enabled": true,
      "email": "service-poc@bc.example",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ]
    }
  ]
}
