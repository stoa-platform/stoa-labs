{
  "description": "ADR-070 tenant viewer: read-only on the txn-accounts-team data stream (txn-accounts-team* + its .ds-* backing indices) with PII fields anonymized via field masking, plus read-only access to the Dashboards tenant accounts-team. Mirrors the LIVE security role; provisioned idempotently by provision.sh / labctl.",
  "cluster_permissions": [],
  "index_permissions": [
    {
      "index_patterns": [
        "txn-accounts-team*",
        ".ds-txn-accounts-team-*"
      ],
      "dls": "",
      "fls": [],
      "masked_fields": [
        "user_ip",
        "user_agent",
        "response_body",
        "request_headers.*",
        "response_headers.*"
      ],
      "allowed_actions": [
        "read",
        "indices:data/read/search",
        "indices:data/read/get",
        "indices:admin/mappings/get",
        "indices:monitor/settings/get",
        "indices:admin/get"
      ]
    }
  ],
  "tenant_permissions": [
    {
      "tenant_patterns": [
        "accounts-team"
      ],
      "allowed_actions": [
        "kibana_all_read"
      ]
    }
  ]
}
