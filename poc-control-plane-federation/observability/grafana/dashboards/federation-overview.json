{
  "title": "STOA Labs \u2014 Federation (observabilite)",
  "uid": "stoa-fed-overview",
  "tags": [
    "stoa",
    "federation",
    "poc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gateway",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## F\u00e9d\u00e9ration \u2014 observabilit\u00e9 unifi\u00e9e\nUn seul plan d'observabilit\u00e9 (OTel -> Tempo/Prometheus) pour des gateways h\u00e9t\u00e9rog\u00e8nes : **Apache APISIX** (OSS) + **webMethods** (mock legacy) \u2014 et **WSO2** quand son exporteur OTel est activ\u00e9 (`scripts/setup-wso2-otel.sh`). S\u00e9lecteur `$gateway`. Donn\u00e9es synth\u00e9tiques \u2014 institution financière régulée (Eurosyst\u00e8me), anonymis\u00e9."
      }
    },
    {
      "type": "timeseries",
      "title": "Requetes/s par gateway (span metrics)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$gateway\"}[1m]))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latence p95 par gateway",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service,le) (rate(traces_spanmetrics_latency_bucket{service=~\"$gateway\"}[5m]))) / 1000",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Traces recentes (Tempo) \u2014 toutes gateways",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceqlSearch",
          "filters": [
            {
              "id": "svc",
              "tag": "service.name",
              "operator": "=~",
              "scope": "resource",
              "value": [
                "$gateway"
              ],
              "valueType": "string"
            }
          ],
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}