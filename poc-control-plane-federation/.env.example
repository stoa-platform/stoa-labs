# .env.example — gabarit versionné des secrets locaux + tags d'images du PoC
# (dépôt PUBLIC).
#
#   cp .env.example .env               # une seule fois
#   set -a && source .env && set +a    # avant de lancer scripts/*.sh ou docker compose
#
# `.env` (le fichier réel, une fois complété) est ignoré par git (.gitignore) :
# il ne quitte jamais ce poste. docker compose le charge aussi tout seul quand
# il est lancé depuis CE répertoire (poc-control-plane-federation/).
#
# IMPORTANT — les variables de SECRET ci-dessous sont volontairement laissées
# VIDES, pas à une valeur d'exemple. `${VAR:?message}` se déclenche aussi bien
# sur une variable ABSENTE que sur une variable VIDE : si ce fichier était
# copié tel quel (cp .env.example .env, sans le compléter), les scripts et
# docker-compose*.yml doivent continuer à s'arrêter tôt avec un message qui
# nomme la variable — jamais démarrer avec un identifiant du dépôt public. Une
# valeur d'exemple non vide (même « manifestement fictive ») aurait satisfait
# ces garde-fous et fait tourner la pile avec un secret publié. Complète
# chaque ligne ci-dessous avec une VRAIE valeur locale avant de sourcer.

# --- OpenSearch (plan gouvernance/audit, ADR-070) ---------------------------
# Mot de passe admin — VARIABLE CANONIQUE UNIQUE : un seul endroit à
# renseigner. Plusieurs scripts le lisent sous des noms différents (héritage —
# OS_PASSWORD, OS_ADMIN_PASS, OS_AUTH) ; chacun d'eux le DÉRIVE désormais de
# OPENSEARCH_PASSWORD dans le script consommateur (pas de variable d'env
# séparée à définir pour eux, donc pas de divergence possible entre les
# quatre).
OPENSEARCH_PASSWORD=
# Overlay analytics (docker-compose.analytics.yml, Data Prepper) : cette
# variable ne suffit PAS pour le sink OpenSearch de pipelines.yaml — Data
# Prepper ne lit pas l'environnement. Après avoir exporté OPENSEARCH_PASSWORD,
# lancer en plus :
#   bash observability/data-prepper/render-pipelines.sh

# Mot de passe du compte de consultation d'audit (tenant viewers, lecture seule).
AUDIT_VIEWER_PASS=

# Mot de passe des viewers RBAC de démonstration (accounts-viewer,
# banking-txn-viewer — provision.sh + provision-banking-demo-txn.sh).
VIEWER_PASS=

# --- Vault (dev-mode, ADR-074) ----------------------------------------------
# VAULT_ROOT_TOKEN = ce que le conteneur Vault ACCEPTE comme jeton racine au
# démarrage (docker-compose.poc.yml) ; VAULT_TOKEN = ce que les scripts
# PRÉSENTENT pour s'authentifier. Les deux DOIVENT être identiques une fois
# renseignés.
VAULT_ROOT_TOKEN=
VAULT_TOKEN=

# --- Secrets clients OAuth2 (Keycloak, service accounts) --------------------
# secret du client Keycloak "ci-applier" (médiation ADR-072) ; lu depuis Vault
# (secret/stoa/ci) par la CI et par les proxies wm-admin.
CI_APPLIER_SECRET=

# secret du client Keycloak "ci-horsprod" (déploiement non-prod, ADR-075).
CI_HORSPROD_SECRET=

# scripts/setup-ci-applier.sh et scripts/setup-ci-horsprod.sh lisent CI_SECRET
# EN PRIORITÉ (surcharge ponctuelle pour un appel isolé), et retombent sinon
# respectivement sur CI_APPLIER_SECRET / CI_HORSPROD_SECRET ci-dessus — pas de
# dérive possible entre le secret avec lequel le client Keycloak est créé et
# celui que Vault distribue ensuite. Ne PAS exporter CI_SECRET ici (les deux
# scripts le liraient identiquement) ; les deux variables ci-dessus suffisent.

# secret du client Keycloak "onboarding-dev" (mint de tokens dev, ROPC).
DEV_SECRET=

# --- Tags d'images docker-compose.poc.yml -----------------------------------
# Sans défaut dans le compose (`${VAR}` nu) : `docker compose config` échoue
# sinon avec "service ... has neither an image nor a build context" — un
# message qui ne dit rien des secrets, à ne pas confondre avec un ${VAR:?...}.
# Versions réelles, vérifiées disponibles au moment de l'écriture de ce
# fichier (registres Docker Hub / Quay) ; à ajuster librement.
WSO2AM_IMAGE=wso2/wso2am:4.5.0
APISIX_IMAGE=apache/apisix:3.17.0-debian
DEX_IMAGE=dexidp/dex:v2.45.1
OTEL_LGTM_IMAGE=grafana/otel-lgtm:0.29.2
MONGO_IMAGE=mongo:7.0
MICROCKS_IMAGE=quay.io/microcks/microcks-uber:1.14.0
