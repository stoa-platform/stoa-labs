# .env.example — gabarit versionné des secrets locaux du PoC (dépôt PUBLIC).
#
#   cp .env.example .env               # une seule fois
#   set -a && source .env && set +a    # avant de lancer scripts/*.sh ou docker compose
#
# `.env` (le fichier réel, une fois complété) est ignoré par git (.gitignore) :
# il ne quitte jamais ce poste. docker compose le charge aussi tout seul quand
# il est lancé depuis CE répertoire (poc-control-plane-federation/).
#
# Aucune des valeurs ci-dessous n'est fonctionnelle : ce sont des exemples
# manifestement fictifs. Sans .env (ou sans les exporter), les scripts et les
# docker-compose*.yml de ce PoC s'arrêtent tôt avec un message qui nomme la
# variable manquante — plus aucun mot de passe/jeton/secret par défaut n'est
# écrit en clair dans le code (dépôt public).

# --- OpenSearch (plan gouvernance/audit, ADR-070) ---------------------------
# Même mot de passe admin partout ; plusieurs scripts le lisent sous des noms
# différents (héritage) — les 3 variables ci-dessous DOIVENT porter LA MÊME
# valeur.
OPENSEARCH_PASSWORD=change-moi-observabilite
OS_PASSWORD=change-moi-observabilite
OS_ADMIN_PASS=change-moi-observabilite
# OS_AUTH = "admin:<mot-de-passe>" — utilisé tel quel par les scripts
# provision*.sh (observability/opensearch/provision/).
OS_AUTH=admin:change-moi-observabilite
# Overlay analytics (docker-compose.analytics.yml, Data Prepper) : cette
# variable ne suffit PAS pour le sink OpenSearch de pipelines.yaml — Data
# Prepper ne lit pas l'environnement. Après avoir exporté OPENSEARCH_PASSWORD,
# lancer en plus :
#   bash observability/data-prepper/render-pipelines.sh

# Mot de passe du compte de consultation d'audit (tenant viewers, lecture seule).
AUDIT_VIEWER_PASS=change-moi-audit

# --- Vault (dev-mode, ADR-074) ----------------------------------------------
# VAULT_ROOT_TOKEN = ce que le conteneur Vault ACCEPTE comme jeton racine au
# démarrage (docker-compose.poc.yml) ; VAULT_TOKEN = ce que les scripts
# PRÉSENTENT pour s'authentifier. Les deux DOIVENT être identiques.
VAULT_ROOT_TOKEN=change-moi-vault-root
VAULT_TOKEN=change-moi-vault-root

# --- Secrets clients OAuth2 (Keycloak, service accounts) --------------------
# secret du client Keycloak "ci-applier" (médiation ADR-072) ; lu depuis Vault
# (secret/stoa/ci) par la CI et par les proxies wm-admin — CI_APPLIER_SECRET
# doit correspondre à la valeur avec laquelle le client a été créé.
CI_APPLIER_SECRET=change-moi-ci-applier

# secret du client Keycloak "ci-horsprod" (déploiement non-prod, ADR-075).
CI_HORSPROD_SECRET=change-moi-ci-horsprod

# ATTENTION : scripts/setup-ci-applier.sh ET scripts/setup-ci-horsprod.sh
# lisent tous deux la MÊME variable générique CI_SECRET (pas
# CI_APPLIER_SECRET/CI_HORSPROD_SECRET) pour CRÉER le client Keycloak
# correspondant. Ne pas exporter CI_SECRET globalement depuis ce fichier —
# elle ne peut valoir qu'UNE chose à la fois. Positionner la valeur voulue au
# moment de l'appel, en cohérence avec CI_APPLIER_SECRET / CI_HORSPROD_SECRET
# ci-dessus :
#   CI_SECRET="$CI_APPLIER_SECRET"  ./scripts/setup-ci-applier.sh
#   CI_SECRET="$CI_HORSPROD_SECRET" ./scripts/setup-ci-horsprod.sh

# secret du client Keycloak "onboarding-dev" (mint de tokens dev, ROPC).
DEV_SECRET=change-moi-onboarding-dev

# --- Hors périmètre de ce fichier -------------------------------------------
# Les tags d'images docker-compose (WSO2AM_IMAGE, APISIX_IMAGE, DEX_IMAGE,
# OTEL_LGTM_IMAGE, MONGO_IMAGE, MICROCKS_IMAGE) sont un gap PRÉEXISTANT, sans
# rapport avec les secrets ci-dessus (cf. HANDOFF.md « Tags d'images : voir
# .env, à confirmer au premier `up` ») — à renseigner séparément.
