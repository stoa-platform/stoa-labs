---
# gateways/templates/publish.yml.tmpl — gabarit de manifeste de publication
# (ADR-076), rendu par scripts/api-request.sh à chaque demande du formulaire
# Jenkins api-request (jamais édité à la main : une PR qui le modifie
# directement est un signal, pas un usage prévu).
#
# FORME reprise à l'identique de clients/_example/apis/accounts-read.publish.yml
# (l'exemple de référence de ce dépôt) : mêmes clés, même structure per_env.
#
# CE QUE L'ÉQUIPE FOURNIT (au formulaire) : name, version, le contrat OpenAPI
# collé (écrit à côté, apis/<name>.openapi.yaml — cf. `contract` ci-dessous),
# et inbound.mode (jwt — seul mode supporté pour l'instant, cf. api-request.sh).
#
# CE QU'ELLE NE SAISIT JAMAIS AU FORMULAIRE : alias_name, issuer, jwks_uri
# (par env). Ce sont des valeurs PLATEFORME, IDENTIQUES pour toutes les
# équipes — relevées de clients/_example/apis/accounts-read.publish.yml et
# POSÉES ici PAR api-request.sh au moment de l'ouverture de la PR.
#
# CE QUE CE GABARIT NE GARANTIT **PAS** (fix round 1, revue — la revendication
# précédente était fausse, corrigée pour dire le vrai) : la garde de liste
# blanche du rôle (roles/apim_publish_api/tasks/manifest-guard.yml,
# apim_pub_manifest_allowed=["apim_api"]) ne borne QUE les clés TOP-LEVEL du
# manifeste — elle vérifie que "apim_api" est la SEULE clé de premier niveau,
# jamais ce qu'il y a DEDANS. Rien n'empêche donc une équipe d'éditer, dans
# SON PROPRE dépôt (avant ou après le merge de cette PR), les valeurs posées
# ici — issuer/jwks_uri/alias_name compris — et le plan (manifest-guard +
# team-name + syntax-check) reste VERT sur un tel manifeste, mesuré en direct
# (per_env.dev.inbound.issuer basculé vers un hôte arbitraire -> toujours
# MANIFEST_KEYS_OK). Chevillage du CONTENU d'apim_api à ces valeurs POSÉES
# À LA GÉNÉRATION relève de l'aval, pas de ce gabarit — tolérance visible, pas
# une promesse. CE QUI EST, LUI, GARDÉ À L'APPLY (revue finale, ne plus le
# renvoyer à une tâche future) : l'APPARTENANCE. Le rôle apim_publish_api refuse
# de toucher une API qui n'appartient pas à l'équipe demandeuse — sur les trois
# chemins (API_OWNER_MISMATCH pour un name+version existant,
# VERSION_BASE_FOREIGN pour un mint, VERSION_RESUME_FOREIGN pour une reprise),
# AVANT toute écriture. Le reste du contenu d'apim_api (issuer/jwks/alias),
# lui, n'est toujours pas chevillé aux valeurs posées ici.
apim_api:
  name: "__API_NAME__"
  version: "__API_VERSION__"
  # PAS "{{ playbook_dir }}/../apis/…" comme l'exemple de référence
  # (clients/_example/apis/accounts-read.publish.yml) — ÉCART DÉLIBÉRÉ,
  # documenté au rapport de tâche. Cette forme ne marche QUE pour un
  # manifeste qui vit DANS poc-control-plane-federation elle-même :
  # playbook_dir y vaut toujours .../ansible, et "../apis/" y désigne
  # poc-control-plane-federation/apis/. Un manifeste posé par api-request vit
  # dans le dépôt de l'ÉQUIPE (apis/ à SA racine à elle, checkée out
  # n'importe où par team-publish) — "../apis/" y pointerait sur le dépôt
  # PLATEFORME, jamais sur le contrat réellement posé à côté de ce fichier
  # (CONSTATÉ : lookup('file', …) sur la forme playbook_dir échoue — le
  # fichier ciblé n'existe pas — quand ce même gabarit est rendu dans un
  # clone hors de poc-control-plane-federation ; reproduit avant ce correctif).
  # `pub_manifest_path` (fait posé par manifest-guard.yml — l'absolu RÉEL du
  # fichier chargé, que l'appelant passe apim_ss_manifest ou pub_manifest_path)
  # donne le dossier où CE manifeste vit VRAIMENT, quel que soit l'appelant :
  # le contrat, écrit juste à côté par api-request.sh, s'y trouve donc TOUJOURS.
  contract: "{{ (pub_manifest_path | dirname) }}/__API_NAME__.openapi.yaml"
  team: ""   # jamais renseigné ici — la chaîne assigne l'équipe (E1, TEAM_FORBIDDEN sinon)
  inbound:
    alias_name: "BankAuth-demo"   # invariant PLATEFORME — jamais saisi par l'équipe
    mode: "__INBOUND_MODE__"      # jwt (signature seule) — seule valeur acceptée par api-request.sh actuellement ;
                                   # oauth2 (strict + audience/scope/client_id) refusé à l'entrée du script
                                   # (INBOUND_OAUTH2_NON_SUPPORTE) tant que ces champs n'ont pas leur propre
                                   # entrée de formulaire — voir T6/T7

  per_env:
    dev:
      inbound:
        issuer: "http://localhost:8480/realms/stoa-lab"
        jwks_uri: "http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/certs"
    rec:
      inbound:
        issuer: "http://localhost:8480/realms/stoa-rec"
        jwks_uri: "http://keycloak:8080/realms/stoa-rec/protocol/openid-connect/certs"
    int:
      inbound:
        issuer: "http://localhost:8480/realms/stoa-int"
        jwks_uri: "http://keycloak:8080/realms/stoa-int/protocol/openid-connect/certs"
    prod:
      inbound:
        issuer: "https://auth.bank.invalid/realms/prod"
        jwks_uri: "https://auth.bank.invalid/realms/prod/protocol/openid-connect/certs"
