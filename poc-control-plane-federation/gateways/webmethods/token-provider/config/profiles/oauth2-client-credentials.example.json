{
  "description": "Provider 3 — la cible saine : OAuth2 client_credentials, client_id/client_secret en Basic auth (RFC 6749 §2.3.1), body reduit au grant et au scope. C'est le profil a viser quand le backend aura ete challenge (RFC 9700 interdit ROPC).",
  "tokenRequest": {
    "urlTemplate": "https://idp.bank.local/oauth2/token",
    "method": "POST",
    "contentType": "application/x-www-form-urlencoded",
    "bodyTemplate": "grant_type=client_credentials&scope={{scope}}",
    "authUserVar": "clientId",
    "authPassVar": "clientSecret",
    "timeoutMillis": 10000
  },
  "params": {
    "scope": "accounts:read"
  },
  "secrets": {
    "vaultPath": "apigw/backends/accounts-api",
    "map": {
      "clientId": "client_id",
      "clientSecret": "client_secret"
    }
  },
  "response": {
    "tokenPath": "access_token",
    "expiresInPath": "expires_in",
    "tokenType": "Bearer"
  }
}
