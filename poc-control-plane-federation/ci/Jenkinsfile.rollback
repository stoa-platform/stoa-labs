// ci/Jenkinsfile.rollback — pipeline ROLLBACK PROD (ADR-075). AUCUN trigger :
// lancé À LA MAIN avec l'ID de la promotion à annuler + une raison + un change
// ITSM. Le rollback N'EST PAS une suppression (aucun DELETE n'existe, ni dans
// labctl ni dans l'allowlist des proxies) : c'est un REVERT GIT ordonné par
// governance-api (POST .../promotions/{id}/rollback — revert du deploy.prod.yaml,
// audité, attribué) suivi d'un RE-APPLY idempotent de l'état Git résultant.
// Rollback = re-apply Git, jamais une mutation manuelle de la gateway.
pipeline {
  agent any
  // Builds SÉRIALISÉS : un acte prod à la fois (et le chemin de token fixe
  // partagé interdit la concurrence — cf. ci/Jenkinsfile).
  options { disableConcurrentBuilds() }
  // PAS de triggers {} : un rollback prod est un acte opéré, jamais un webhook.
  parameters {
    string(name: 'PROMOTION_ID', defaultValue: '', description: 'ID de la promotion prod à annuler')
    string(name: 'REASON',       defaultValue: '', description: 'Raison du rollback (audit)')
    string(name: 'CHANGE_REF',   defaultValue: '', description: 'Change ITSM couvrant le rollback (ex. CHG-0003)')
    // Identité NOMINATIVE de l'opérateur (voie A, ADR-078 §3). Vides → repli
    // AppRole : identité de MACHINE, acte non imputable — comportement historique.
    // Le token nominatif exige la policy `operator-deploy` (secrets de PLATEFORME) :
    // son octroi à des humains est une décision client (ADR-078 § Décisions, n°9).
    string(name: 'VAULT_USER', defaultValue: '',
           description: "Identité NOMINATIVE de l'opérateur : login annuaire. Vide = repli AppRole (acte non imputable).")
    password(name: 'VAULT_USER_PASSWORD', defaultValue: '',
             description: "Mot de passe annuaire, saisi à chaque rollback. ⚠ Ne pas rejouer après un refus (lockout AD).")
  }
  environment {
    GOPROXY = 'off'; GOFLAGS = '-mod=vendor'; GOSUMDB = 'off'
    // É0 — auth Git (cf. ci/Jenkinsfile) : défauts PoC anonymes, surchargeables
    // au niveau job ; GIT_CREDENTIALS_ID non vide -> clone via GIT_ASKPASS.
    GOVERNANCE_GIT_URL = "${env.GOVERNANCE_GIT_URL ?: 'http://gitea:3000/ci/governance.git'}"
    GIT_CREDENTIALS_ID = "${env.GIT_CREDENTIALS_ID ?: ''}"
    KEYCLOAK_URL                = 'http://localhost:8480'
    KEYCLOAK_JWKS_URL           = 'http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/certs'
    LABCTL_AUDIENCE             = 'onboarding-api'
    OPENSEARCH_URL              = 'https://opensearch:9200'
    OPENSEARCH_USER             = 'admin'
    OPENSEARCH_INSECURE         = 'true'
    OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-lgtm:4318'
    APPLY_TENANT                = 'banking-demo'
    // Le re-apply prod passe par apply-uac : la couche dispatch-gate (A6) relit
    // l'ITSM du change de l'état N-1 restauré (deploy.prod.yaml reverté). Sans
    // ITSM_URL elle refuserait fail-closed (ITSM_NOT_CONFIGURED). NB PoC/mock :
    // le change du N-1 reste 'approved' ; un ITSM RÉEL le passerait 'implemented'
    // post-MEP → un rollback d'urgence devrait porter son propre change_ref
    // (param CHANGE_REF) plutôt que celui du N-1 — durcissement documenté (A6).
    ITSM_URL                    = 'http://itsm-mock:8788'
    VAULT_ADDR                  = 'http://vault:8200'
    VAULT_ROLE_ID               = "${env.VAULT_ROLE_ID ?: 'fa09b310-79a7-8845-609b-9b6090bcd53b'}"
    // governance-api tourne sur le HOST dans le PoC (:8787) — depuis l'agent
    // Jenkins, host.docker.internal (Docker Desktop). Sur un démon Linux nu :
    // ajouter extra_hosts host-gateway au service jenkins, ou pointer un
    // governance-api conteneurisé. Surchargable au niveau job.
    GOVERNANCE_API_URL          = 'http://host.docker.internal:8787'
  }
  stages {
    stage('Build labctl (air-gapped, vendored)') {
      steps {
        dir('poc-control-plane-federation/labctl') {
          sh 'go build -trimpath -o "$WORKSPACE/labctl" .'
        }
      }
    }
    stage('Rollback governance — POST promotions/{id}/rollback') {
      steps {
        dir('poc-control-plane-federation') {
          withCredentials([string(credentialsId: 'vault-ci-secret-id', variable: 'VAULT_SECRET_ID')]) {
            sh '''
              set +x          # NEVER echo: secret_id, vault token, OAuth token
              set -eu
              [ -n "$PROMOTION_ID" ] && [ -n "$REASON" ] && [ -n "$CHANGE_REF" ] \
                || { echo 'PROMOTION_ID, REASON et CHANGE_REF sont requis'; exit 1; }
              # Token compte de SERVICE (client_credentials ci-applier — même
              # pattern que les autres jobs : le job ne porte aucun mot de passe
              # utilisateur ; le secret du client vient de Vault).
              # ⚠ PRÉREQ : governance-api gate le rollback sur la permission
              # promotions:approve (rôles realm devops/cpi-admin) — assigner le
              # rôle `devops` à service-account-ci-applier (one-shot, admin KC),
              # sinon 403. En prod : un client de service rollback DÉDIÉ.
              # Login Vault mutualisé : NOMINATIF si l'opérateur a saisi VAULT_USER +
              # son mot de passe, sinon repli AppRole (identité de machine, historique).
              . ci/lib/vault-login.sh
              trap vault_trap_revoke EXIT
              vault_login_any || exit 1
              CI_SECRET=$(vault_read secret/data/stoa/ci ciApplierSecret)
              # client_secret par le CORPS via printf (builtin : ni process ni argv).
              SARESP=$(vault_tmpfile sa-resp.json)
              printf 'client_id=ci-applier\\ngrant_type=client_credentials\\nclient_secret=%s\\n' "$CI_SECRET" \\
                | form_post_no_argv "$SARESP" http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/token >/dev/null
              unset CI_SECRET
              SA_TOKEN=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["access_token"])' "$SARESP")
              [ -n "$SA_TOKEN" ] || { echo 'no service-account token'; exit 1; }
              # Le revert est fait PAR governance-api (commit Git attribué +
              # marker rolled_back) — le job ne touche jamais le repo à la main.
              BODY=$(printf '{"reason":"%s","change_ref":"%s"}' "$REASON" "$CHANGE_REF")
              CODE=$(curl -s -o /tmp/rollback-resp.json -w '%{http_code}' \
                -X POST "$GOVERNANCE_API_URL/api/v1/tenants/$APPLY_TENANT/promotions/$PROMOTION_ID/rollback" \
                -H "Authorization: Bearer $SA_TOKEN" -H 'Content-Type: application/json' -d "$BODY")
              unset SA_TOKEN
              cat /tmp/rollback-resp.json; echo
              [ "$CODE" = 200 ] || [ "$CODE" = 201 ] || { echo "rollback governance KO (HTTP $CODE)"; exit 1; }
              echo "✓ promotion $PROMOTION_ID annulée côté governance (raison: $REASON, change: $CHANGE_REF)"
            '''
          }
        }
      }
    }
    stage('Checkout governance (post-revert)') {
      steps {
        dir('poc-control-plane-federation') {
          // Re-clone APRÈS le revert : l'état appliqué est l'état Git
          // post-rollback (version précédente pinnée) — convergence idempotente.
          // Clone COMPLET (pas de --depth 1) : ResolvePinned lit git show
          // <commit>:… et exige l'historique. Auth Git optionnelle (É0).
          script { cloneGovernance() }
        }
      }
    }
    stage('Re-apply PROD — convergence de l\'état Git reverté') {
      steps {
        dir('poc-control-plane-federation') {
          withCredentials([string(credentialsId: 'vault-ci-secret-id', variable: 'VAULT_SECRET_ID')]) {
            sh '''
              set +x
              set -eu
              # Même login mutualisé que le stage précédent : nominatif, sinon AppRole.
              . ci/lib/vault-login.sh
              trap vault_trap_revoke EXIT
              vault_login_any || exit 1
              CI_SECRET=$(vault_read secret/data/stoa/ci ciApplierSecret)
              OPENSEARCH_PASSWORD=$(vault_read secret/data/stoa/opensearch adminPassword)
              export OPENSEARCH_PASSWORD
              KCRESP=$(vault_tmpfile kc-resp.json)
              printf 'client_id=ci-applier\\ngrant_type=client_credentials\\nclient_secret=%s\\n' "$CI_SECRET" \\
                | form_post_no_argv "$KCRESP" http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/token >/dev/null
              unset CI_SECRET
              TOKFILE=$(vault_tmpfile labctl-token)
              python3 -c 'import json,sys;open(sys.argv[2],"w").write(json.load(open(sys.argv[1]))["access_token"])' \\
                "$KCRESP" "$TOKFILE"
              [ -s "$TOKFILE" ] || { echo 'no CI token'; exit 1; }
              # Le repo governance post-revert a été cloné par le stage
              # 'Checkout governance (post-revert)' (auth Git É0).
              [ -d governance/.git ] || { echo 'governance/ absent (stage Checkout KO ?)'; exit 1; }
              LABCTL_TOKEN_FILE="$TOKFILE" "$WORKSPACE/labctl" apply-uac \
                --repo governance --env prod --tenant "$APPLY_TENANT" -f envs/prod/targets.cluster.yaml
            '''
          }
        }
      }
    }
    stage('Smoke test — data-plane prod (état reverté)') {
      steps {
        dir('poc-control-plane-federation') {
          sh '''
            set -eu
            "$WORKSPACE/labctl" get apis -f envs/prod/targets.cluster.yaml
            CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 \
              "http://webmethods-real:5555/gateway/accounts-read/1.0.0/accounts")
            echo "data-plane sans token -> HTTP $CODE"
            [ "$CODE" = 401 ] || { echo "SMOKE KO: attendu 401 sans token (reçu $CODE)"; exit 1; }
            echo 'SMOKE OK — rollback convergé, barrière OAuth2 active.'
          '''
        }
      }
    }
  }
  post {
    success { echo '✓ rollback prod = revert Git audité + re-apply idempotent (jamais de DELETE gateway).' }
    failure { echo '✗ rollback KO — voir le log de l\'étape.' }
  }
}

// É0 — clone du repo governance avec auth Git OPTIONNELLE (même convention que
// ci/Jenkinsfile) : GIT_CREDENTIALS_ID vide -> anonyme (PoC) ; posé -> creds via
// GIT_ASKPASS éphémère (jamais URL/argv/log). Clone COMPLET (ResolvePinned).
def cloneGovernance() {
  def clone = {
    sh '''
      set -eu
      rm -rf governance
      if [ -n "${GIT_USER:-}" ]; then
        ASKPASS="$WORKSPACE/.git-askpass"
        printf '#!/bin/sh\\ncase "$1" in Username*) printf %%s "$GIT_USER" ;; *) printf %%s "$GIT_PASS" ;; esac\\n' > "$ASKPASS"
        chmod 700 "$ASKPASS"
        GIT_ASKPASS="$ASKPASS" GIT_TERMINAL_PROMPT=0 git clone "$GOVERNANCE_GIT_URL" governance
        rm -f "$ASKPASS"
      else
        GIT_TERMINAL_PROMPT=0 git clone "$GOVERNANCE_GIT_URL" governance
      fi
    '''
  }
  if (env.GIT_CREDENTIALS_ID?.trim()) {
    withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID,
                                      usernameVariable: 'GIT_USER',
                                      passwordVariable: 'GIT_PASS')]) { clone() }
  } else {
    clone()
  }
}
