<?xml version='1.1' encoding='UTF-8'?>
<!--
  team-request — PIPELINE FROM SCM (plus de Groovy inline).

  Ce fichier ne porte QUE la coquille du job : le FORMULAIRE (ses champs) et
  d'ou il charge son pipeline. Le pipeline lui-meme vit dans
  ci/Jenkinsfile.team-request (declaratif, versionne, relisible par l'ops).

  Le bloc <parameterDefinitions> ci-dessous DOIT rester le miroir exact du bloc
  `parameters { … }` du Jenkinsfile. C'est CELUI-CI qui gagne, et c'est
  contre-intuitif : Declarative ne remplace QUE les proprietes qu'il a
  lui-meme posees (DeclarativeJobPropertyTrackerAction) ; un parametre venu
  d'un config.xml est PRESERVE tel quel, indefiniment, et l'emporte a nom egal
  sur celui du Jenkinsfile. Meme mecanique que le declencheur de team-publish,
  MESUREE sur le lab (2026-08-06).

  AUCUN champ d'environnement (G4, ADR-082, D5) : onboarder une equipe est un
  geste d'AUTHORING, et scripts/team-request.sh scelle son env sur la constante
  DEPLOY_PIN_AUTHORING_ENV de scripts/lib/deploy-pin.sh. Le champ a ete retire
  d'ICI EN PREMIER : un parametre de config.xml est preserve indefiniment et
  l'emporte a nom egal, donc l'oter du seul Jenkinsfile n'aurait rien ote au
  formulaire reellement pose.

  Consequence : une divergence entre les deux fichiers est SILENCIEUSE, et
  c'est le XML qui fait foi. test-team-request-wiring.sh §2 et §3 comparent les
  deux (noms et types, et l'absence de toute liste fermee depuis que l'axe env
  est parti) et virent au rouge a la premiere divergence.

  A NE PAS DEPLACER dans le Jenkinsfile : setup-team-onboard-jobs.sh pose ce
  XML tel quel. Ce job ne porte AUCUN marqueur de liste dynamique (CHOICES,
  variantes TEAMS et APIS) : il est donc copie octet pour octet, sans passer
  par sed et sans dependre de Gitea ni d'un token (no-op de substitution
  prouve par test-generate-choices.sh §5). Ecrire ici un tel marqueur, meme
  dans un commentaire, suffirait a faire basculer le job en mode substitution
  (la detection est un grep sur le fichier entier) et a lui imposer un Gitea
  joignable a chaque pose.
-->
<flow-definition plugin="workflow-job">
  <description>Formulaire : onboarder une équipe → PR onboard/* + plan commenté. La décision reste le MERGE (ADR-081) ; le dépôt et les objets naissent au merge (job team-apply). PIPELINE FROM SCM : le pipeline est ci/Jenkinsfile.team-request, chargé depuis le dépôt plateforme (branche main) — ce job ne contient AUCUN Groovy.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>TEAM</name>
          <description>Nom d'équipe — minuscules/chiffres/tirets (^[a-z0-9][a-z0-9-]{1,30}$). Devient : svc-&lt;team&gt;, &lt;team&gt;-devs, deploy/&lt;team&gt;/wm-admin, deploy-&lt;team&gt;.</description>
          <defaultValue></defaultValue>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>DESCRIPTION</name>
          <description>Description de l'équipe (sans guillemets doubles, ni \, ni retour à la ligne).</description>
          <defaultValue></defaultValue>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>APPROVERS</name>
          <description>Matricules des approbateurs [A-Za-z0-9_-], séparés par des virgules. VIDE ACCEPTÉ : la projection owner ne fera rien tant que la liste n'est pas établie.</description>
          <defaultValue></defaultValue>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>REPO</name>
          <description>Dépôt Git de l'équipe (org/nom). Vide = &lt;team&gt;/apis. Créé AU MERGE depuis le squelette ADR-076.</description>
          <defaultValue></defaultValue>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <!-- Depot PLATEFORME vu DEPUIS l'agent (reseau docker) : exactement
               l'URL et la branche du `stage('checkout') { git url: … }` du job
               Groovy d'origine. C'est aussi ce que le checkout implicite de
               Declarative repose dans le workspace, d'ou la disparition du
               `git url:` explicite du pipeline. -->
          <url>http://gitea:3000/ci/stoa-labs.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>poc-control-plane-federation/ci/Jenkinsfile.team-request</scriptPath>
    <!-- lightweight=false : le workspace de l'agent doit porter le depot
         (scripts/, ansible/), pas seulement le Jenkinsfile. -->
    <lightweight>false</lightweight>
  </definition>
  <!-- Aucun declencheur : ce job est un FORMULAIRE, jamais un webhook. Le
       Jenkinsfile n'a symetriquement aucun bloc `triggers { … }` (miroir de
       l'absence). L'apply, lui, est declenche par le MERGE de la PR ouverte
       ici, sur un AUTRE job (team-apply). -->
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
