<?xml version='1.1' encoding='UTF-8'?>
<!--
  provisioning-request — PIPELINE FROM SCM (plus de Groovy inline, A0 du GOAL
  cd-applications 2026-09-02).

  Ce fichier ne porte QUE la coquille du job : d'ou il charge son pipeline, et
  le declencheur qui doit exister DES LA POSE du job (c'est lui que l'API
  provisioning de la gateway appelle, cf. scripts/setup-provisioning-api.sh).
  Le pipeline lui-meme vit dans ci/Jenkinsfile.provisioning-request
  (declaratif, versionne, compile par `make lint-ci`).

  Le bloc <triggers> ci-dessous DOIT rester le miroir exact du bloc
  `triggers { GenericTrigger(...) }` du Jenkinsfile : c'est CELUI-CI qui gagne
  (Declarative ne remplace que les declencheurs qu'il a lui-meme poses, mesure
  sur le lab 2026-08-06). scripts/lib/gwt-mirror.sh (test-a0-wiring.sh) compare
  les deux champ a champ.

  Re-pose : scripts/setup-provision-request-job.sh (token Gitea + credential +
  job) ou, pour la coquille seule, JOBS=provisioning-request
  scripts/setup-provision-jobs.sh (POST config.xml, historique conserve).
-->
<flow-definition plugin="workflow-job">
  <description>Maillon 1, VOIE MACHINE : demande OIG/CLI2 (via l'API provisioning de la gateway, authentifiee + scope) -&gt; manifeste (fusion per_env, A1) + Pull Request provision/&lt;app&gt;-&lt;env&gt; sur ci/stoa-labs ; le plan (provision-plan) se declenche sur la PR, la decision reste le MERGE (ADR-078 : un webhook ne porte aucun humain). PIPELINE FROM SCM : ci/Jenkinsfile.provisioning-request, charge depuis le depot plateforme (branche main) -- ce job ne contient AUCUN Groovy et ne liste AUCUN champ : il herite de tout enrichissement de scripts/provision-request.sh.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
        <org.jenkinsci.plugins.gwt.GenericTrigger plugin="generic-webhook-trigger@2.4.2">
          <spec></spec>
          <genericVariables>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_APP</key><value>$.app</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_ENV</key><value>$.env</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_CLIENT_ID</key><value>$.clientId</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_API</key><value>$.api</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_API_VER</key><value>$.apiVersion</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_AUDIENCE</key><value>$.audience</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>REQ_CALLER</key><value>$.caller</value></org.jenkinsci.plugins.gwt.GenericVariable>
          </genericVariables>
          <printPostContent>true</printPostContent>
          <printContributedVariables>true</printContributedVariables>
          <token>stoa-provision-request</token>
          <silentResponse>false</silentResponse>
          <overrideQuietPeriod>false</overrideQuietPeriod>
          <shouldNotFlattern>false</shouldNotFlattern>
          <allowSeveralTriggersPerBuild>false</allowSeveralTriggersPerBuild>
        </org.jenkinsci.plugins.gwt.GenericTrigger>
      </triggers>
    </org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <!-- Depot PLATEFORME vu DEPUIS l'agent (reseau docker) : c'est celui
               que le checkout implicite de `agent any` repose dans le workspace. -->
          <url>http://gitea:3000/ci/stoa-labs.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>poc-control-plane-federation/ci/Jenkinsfile.provisioning-request</scriptPath>
    <!-- lightweight=false : le workspace de l'agent doit porter le depot
         (scripts/provision-request.sh et sa lib), pas seulement le Jenkinsfile. -->
    <lightweight>false</lightweight>
  </definition>
  <disabled>false</disabled>
</flow-definition>
