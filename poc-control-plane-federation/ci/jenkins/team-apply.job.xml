<?xml version='1.1' encoding='UTF-8'?>
<!--
  team-apply — PIPELINE FROM SCM (plus de Groovy inline).

  Ce fichier ne porte QUE la coquille du job : d'ou il charge son pipeline, et
  le declencheur qui doit exister DES LA POSE du job. Le pipeline lui-meme vit
  dans ci/Jenkinsfile.team-apply (declaratif, versionne, relisible par l'ops).

  Le bloc <triggers> ci-dessous DOIT rester le miroir exact du bloc
  `triggers { GenericTrigger(...) }` du Jenkinsfile. C'est CELUI-CI qui gagne,
  et c'est contre-intuitif : Declarative ne remplace QUE les declencheurs
  qu'il a lui-meme poses (DeclarativeJobPropertyTrackerAction) ; un
  declencheur venu d'un config.xml est PRESERVE tel quel, indefiniment.
  MESURE sur le lab (2026-08-06, sur le jumeau team-publish) : token du XML
  volontairement different de celui du Jenkinsfile, 4 builds, le XML n'a jamais
  bouge ; le meme XML prive de son bloc <triggers> a bien laisse le Jenkinsfile
  installer le sien.

  Consequence : une divergence entre les deux fichiers est SILENCIEUSE, et
  c'est le XML qui fait foi. test-team-apply-wiring.sh §3 compare les deux
  et vire au rouge a la premiere divergence.
-->
<flow-definition plugin="workflow-job">
  <description>Apply post-merge (onboarding equipe) : une PR onboard/* FUSIONNEE ouvre une DEMANDE EN ATTENTE dans Jenkins (input) ; sur validation + identite Vault -> apply nominatif via scripts/team-apply.sh (miroir de provision-apply.job.xml). PIPELINE FROM SCM : le pipeline est ci/Jenkinsfile.team-apply, charge depuis le depot plateforme (branche main) -- ce job ne contient AUCUN Groovy.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty/>
    <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
        <org.jenkinsci.plugins.gwt.GenericTrigger plugin="generic-webhook-trigger@2.4.2">
          <spec></spec>
          <genericVariables>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>PR_BRANCH</key><value>$.pull_request.head.ref</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>PR_NUMBER</key><value>$.pull_request.number</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>PR_ACTION</key><value>$.action</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>PR_MERGED</key><value>$.pull_request.merged</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <!-- Qui a validé, et qui avait demandé. SANS eux la garde d'identité
                 ne peut RIEN vérifier et refuse (MERGER_UNKNOWN) : ces deux
                 lignes ne sont pas décoratives, elles sont la garde
                 (mêmes clés que provision-apply.job.xml). -->
            <org.jenkinsci.plugins.gwt.GenericVariable><key>PR_MERGED_BY</key><value>$.pull_request.merged_by.login</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <org.jenkinsci.plugins.gwt.GenericVariable><key>PR_REQUESTER</key><value>$.pull_request.user.login</value></org.jenkinsci.plugins.gwt.GenericVariable>
            <!-- ANTI-TOCTOU (team-apply.sh) : l'équipe est lue dans
                 providers.<env>.yml TEL QUE MERGÉ, jamais dans le payload du
                 webhook — d'où le besoin du SHA de merge, absent de
                 provision-apply.job.xml (qui n'a pas ce garde-fou). -->
            <org.jenkinsci.plugins.gwt.GenericVariable><key>MERGE_SHA</key><value>$.pull_request.merge_commit_sha</value></org.jenkinsci.plugins.gwt.GenericVariable>
          </genericVariables>
          <printContributedVariables>true</printContributedVariables>
          <printPostContent>false</printPostContent>
          <token>stoa-team-apply</token>
          <silentResponse>false</silentResponse>
          <regexpFilterText>$PR_ACTION|$PR_MERGED</regexpFilterText>
          <regexpFilterExpression>^closed\|true$</regexpFilterExpression>
          <overrideQuietPeriod>false</overrideQuietPeriod>
          <shouldNotFlattern>false</shouldNotFlattern>
          <allowSeveralTriggersPerBuild>false</allowSeveralTriggersPerBuild>
        </org.jenkinsci.plugins.gwt.GenericTrigger>
      </triggers>
    </org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <!-- Depot PLATEFORME vu DEPUIS l'agent (reseau docker) : c'est celui
               que `checkout scm` repose dans le workspace, d'ou la disparition
               du `git url: …, branch: 'main'` explicite du pipeline. -->
          <url>http://gitea:3000/ci/stoa-labs.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>poc-control-plane-federation/ci/Jenkinsfile.team-apply</scriptPath>
    <!-- lightweight=false : le workspace de l'agent doit porter le depot
         (scripts/, ansible/, ci/lib/), pas seulement le Jenkinsfile. -->
    <lightweight>false</lightweight>
  </definition>
  <disabled>false</disabled>
</flow-definition>
