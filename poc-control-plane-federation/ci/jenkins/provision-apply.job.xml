<!--
  provision-apply — PIPELINE FROM SCM (plus de Groovy inline, A2 / A0 du GOAL
  cd-applications 2026-09-02).

  Ce fichier ne porte QUE la coquille du job : d'ou il charge son pipeline, et
  le declencheur qui doit exister DES LA POSE du job. Le pipeline lui-meme vit
  dans ci/Jenkinsfile.provision-apply (declaratif, versionne, relisible par
  l'ops, compile par `make lint-ci`).

  Ce fichier ne porte AUCUNE propriete (L6, 2026-09-11) : voir <properties/>
  ci-dessous. Le declencheur est pose par le Jenkinsfile a son premier build.

  Re-pose : scripts/setup-provision-jobs.sh (POST config.xml, historique des
  builds conserve).
-->
<flow-definition plugin="workflow-job">
  <description>Apply post-merge d'une DEMANDE D'APPLICATION : une PR provision/&lt;app&gt;-&lt;env&gt; FUSIONNEE est RECONCILIEE avec la forge (Gitea ou GitLab -- le payload ne fait pas foi), ouvre une DEMANDE EN ATTENTE (input), puis -- identite Vault nominative confrontee a l'auteur du merge -- apply via selfservice-app-deploy AU SHA MERGE (A2), jamais au dernier __GIT_BASE__ ; la PR recoit resultat, identite, SHA et digest. PIPELINE FROM SCM : ci/Jenkinsfile.provision-apply, charge depuis le depot plateforme (branche __GIT_BASE__) -- ce job ne contient AUCUN Groovy.</description>
  <keepDependencies>false</keepDependencies>
  <!-- L6 (2026-09-11) : AUCUNE propriete ici, et c'est le contrat de ce job.
       Le declencheur (selon la globale WEBHOOK_KIND : generic-webhook-trigger ou
       GitLab Plugin) et DisableConcurrentBuilds sont poses par le Jenkinsfile,
       par un properties() SCRIPTE, a son PREMIER BUILD - l'AMORCAGE, que
       setup-provision-jobs.sh declenche, ATTEND et RELIT (AMORCAGE_INCOMPLET
       sinon). MESURE le 2026-09-11 (scripts/spike-webhook-kind-m2m4.sh) : un XML
       porteur du meme declencheur + ce properties() donne un DOUBLON au build 1
       (2 GenericTrigger), puis l'exemplaire du XML est PERDU au build 2 - un XML
       porteur n'est donc pas une ceinture, c'est une avarie differee.
       scripts/lib/gwt-mirror.sh rend pour ce job « DIVERGENCE trigger xml=absent
       jenkinsfile=present token=… vars=N » : c'est l'ETAT VOULU, pas un ecart. -->
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <!-- Depot PLATEFORME vu DEPUIS l'agent (reseau docker) : c'est celui
               que `checkout scm` repose dans le workspace. -->
          <url>http://gitea:3000/ci/stoa-labs.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/__GIT_BASE__</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>poc-control-plane-federation/ci/Jenkinsfile.provision-apply</scriptPath>
    <!-- lightweight=false : le workspace de l'agent doit porter le depot
         (scripts/, ci/lib/), pas seulement le Jenkinsfile. -->
    <lightweight>false</lightweight>
  </definition>
  <disabled>false</disabled>
</flow-definition>
