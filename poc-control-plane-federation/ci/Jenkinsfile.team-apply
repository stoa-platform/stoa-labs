// ci/Jenkinsfile.team-apply — APPLY post-merge d'ONBOARDING D'ÉQUIPE (palier 2).
//
// Conversion DÉCLARATIVE du pipeline qui vivait en Groovy inline dans
// ci/jenkins/team-apply.job.xml (<script>…</script>). Même modèle que son jumeau
// ci/Jenkinsfile.team-publish (côté publication) : le job est MINCE, toute la
// substance vit dans scripts/team-apply.sh et ansible/roles/apim_team_onboard —
// le pipeline ne fait que router des variables de webhook vers le script.
//
//   merge d'une PR onboard/<équipe>-<env> dans le DÉPÔT PLATEFORME
//     ──webhook──▶ demande EN ATTENTE (input) : la décision est DÉJÀ prise (le
//                  merge) — la pause ne re-décide pas, elle fournit l'identité
//                  NOMINATIVE qui portera l'apply (policy Vault team-onboarder,
//                  posée par setup-team-onboard-prereqs.sh).
//        humain ──▶ garde d'identité (assert-merge-identity.sh) puis apply
//                  nominatif → token Vault → scripts/team-apply.sh.
//
// ANTI-TOCTOU : l'équipe et son dépôt sont lus dans providers.<env>.yml TEL QUE
// MERGÉ (checkout au MERGE_SHA, fait par team-apply.sh), JAMAIS dans la charge
// utile du webhook — d'où le besoin du SHA de merge, absent de
// provision-apply.job.xml (qui n'a pas ce garde-fou).
//
// Login, révocation et preuve de mort du token : ci/lib/vault-login.sh (ADR-078 §2).
pipeline {

  // `agent none` — DÉLIBÉRÉ, ce n'est pas un oubli. La demande en attente
  // (directive `input` ci-dessous) est évaluée AVANT que l'agent de l'étape ne
  // soit alloué : une pause qui attend une réponse humaine (minutes, heures)
  // ne réserve donc AUCUN exécuteur. Un `agent any` au niveau pipeline
  // gâcherait un slot pendant toute l'attente — c'est la raison pour laquelle
  // l'`input()` était déjà HORS du `node{}` dans la version Groovy.
  agent none
  options { disableConcurrentBuilds() }   // un apply à la fois = régime bancaire

  // Aucune charge utile n'est de confiance : ces clés ne servent qu'à NOMMER ce
  // qu'il faut relire dans l'état MERGÉ (team-apply.sh checkoute MERGE_SHA puis
  // relit providers.<env>.yml) et à confronter le répondant de la pause à
  // l'auteur du merge.
  //
  // ⚠ Ce bloc doit rester le MIROIR EXACT de celui de ci/jenkins/team-apply.job.xml,
  // et c'est le XML qui gagne : Declarative ne remplace que les déclencheurs
  // qu'il a lui-même posés (DeclarativeJobPropertyTrackerAction) — un
  // déclencheur venu d'un config.xml est préservé indéfiniment, et une
  // divergence entre les deux fichiers serait SILENCIEUSE (mesuré sur le lab,
  // 2026-08-06). test-team-apply-wiring.sh §3 compare les deux. Ce bloc reste
  // ici parce qu'il est le seul déclencheur quand le job est posé SANS XML
  // (multibranch, organization folder, ou re-création depuis le seul dépôt).
  // Volontairement PAS de bloc `parameters {}` : ces valeurs ne doivent venir
  // QUE du webhook. Les exposer en paramètres de build permettrait à quiconque
  // a le droit de lancer le job de saisir lui-même `PR_MERGED_BY` et de passer
  // sa propre garde d'identité (auto-validation). Un build manuel n'a donc
  // aucune de ces variables → `${VAR:?}` côté script → refus nommé.
  triggers {
    GenericTrigger(
      token: 'stoa-team-apply',
      genericVariables: [
        [key: 'PR_BRANCH',    value: '$.pull_request.head.ref'],
        [key: 'PR_NUMBER',    value: '$.pull_request.number'],
        [key: 'PR_ACTION',    value: '$.action'],
        [key: 'PR_MERGED',    value: '$.pull_request.merged'],
        // Qui a validé, et qui avait demandé. SANS eux la garde d'identité ne
        // peut RIEN vérifier et refuse (MERGER_UNKNOWN) : ces deux lignes ne
        // sont pas décoratives, elles SONT la garde (mêmes clés que
        // team-publish / provision-apply).
        [key: 'PR_MERGED_BY', value: '$.pull_request.merged_by.login'],
        [key: 'PR_REQUESTER', value: '$.pull_request.user.login'],
        // ANTI-TOCTOU (team-apply.sh) : l'équipe est lue dans
        // providers.<env>.yml TEL QUE MERGÉ, jamais dans la charge utile.
        [key: 'MERGE_SHA',    value: '$.pull_request.merge_commit_sha'],
      ],
      // Ne déclenche que sur une PR RÉELLEMENT fusionnée (fermée sans merge = rien).
      regexpFilterText: '$PR_ACTION|$PR_MERGED',
      regexpFilterExpression: '^closed\\|true$',
      printContributedVariables: true,
      printPostContent: false)
  }

  // ── POINTS DE CONFIG CLIENT ────────────────────────────────────────────────
  // Les `export VAR="${VAR:-défaut}"` qui vivaient DANS le bloc `sh` du job
  // Groovy sont devenus des entrées de ce bloc : Jenkins les exporte à tous les
  // steps, donc la valeur est dans l'environnement AVANT que vault-login.sh ne
  // soit sourcé, et elle reste surchargeable par variable d'environnement du
  // nœud (motif `env.X ?: défaut`, identique aux Jenkinsfile frères) — le MÊME
  // fichier sert le lab et le client, sans fork.
  //
  // ⚠ Les hôtes sont ceux vus DEPUIS le conteneur de l'agent (réseau docker
  // `poc`) : `localhost` n'y désigne PAS Jenkins/Gitea/Vault — fix mesuré
  // (Task 7), la re-pose des formulaires était injoignable avec un défaut
  // localhost:18080.
  environment {
    VAULT_ADDR            = "${env.VAULT_ADDR ?: 'http://vault:8200'}"
    // Mount de l'auth user/mot de passe. CORRECTION INTER-TÂCHES (Task 8, gap
    // trouvé par exécution RÉELLE du chemin fort) : ci/lib/vault-login.sh
    // retombe sur son défaut `ldap` (la convention CLIENT — AD) si cette
    // variable n'est pas fixée ; ce lab authentifie ses opérateurs nominatifs
    // en `userpass` (posés par setup-vault-userpass.sh), jamais en ldap (aucun
    // annuaire dans ce docker-compose). Sans elle, le login est refusé HTTP 403
    // sur auth/ldap/login pour un compte qui n'existe qu'en auth/userpass —
    // reproduit en direct. Posée ICI, donc exportée au shell AVANT que la lib
    // ne soit sourcée (elle lit VAULT_USER_AUTH_MOUNT au moment du login, pas
    // après). Chez le client → `ldap`, MÊME requête REST, seul le mount change.
    VAULT_USER_AUTH_MOUNT = "${env.VAULT_USER_AUTH_MOUNT ?: 'userpass'}"
    // Base de l'API d'admin de la gateway. Défaut = le MOCK in-cluster (réseau
    // compose `poc`, service webmethods-mock) — JAMAIS 5555/la vraie gateway
    // ici. team-apply.sh refuse de démarrer sans elle (${APIM_API_BASE:?…}).
    APIM_API_BASE         = "${env.APIM_API_BASE ?: 'http://webmethods-mock:8080/rest/apigateway'}"
    // Dépôt PLATEFORME (porte providers.<env>.yml et la PR d'onboarding) et son
    // hôte, vus depuis l'agent — mêmes valeurs que les défauts internes de
    // team-apply.sh, dites ici pour être surchargeables en un seul endroit.
    GIT_HOST              = "${env.GIT_HOST ?: 'http://gitea:3000'}"
    GIT_REPO              = "${env.GIT_REPO ?: 'ci/stoa-labs'}"
    // GIT_WEB_HOST : lien humain-CLIQUABLE dans le commentaire de PR (même
    // convention que provision-plan.job.xml — GIT_HOST reste le nom interne au
    // cluster, non résolu hors des conteneurs).
    GIT_WEB_HOST          = "${env.GIT_WEB_HOST ?: 'http://localhost:13000'}"
    // Cible in-cluster pour la RE-POSE événementielle des formulaires
    // app-request/api-request après onboarding (l'équipe doit apparaître dans
    // les listes déroulantes sans relance manuelle).
    JENKINS_UI            = "${env.JENKINS_UI ?: 'http://jenkins:8080'}"
    // Credential Jenkins (secret text) portant le token Gitea du CI.
    GITEA_CREDENTIALS_ID  = "${env.GITEA_CREDENTIALS_ID ?: 'gitea-provision-token'}"
  }

  stages {

    // Étape SANS agent (aucun exécuteur consommé) : nomme le build et dit
    // pourquoi, le cas échéant, il n'y a rien à appliquer.
    stage('Contexte du webhook') {
      steps {
        script {
          // Même découpage que team-apply.sh (`REST=${PR_BRANCH#onboard/}` puis
          // `ENVN=${REST##*-}` / `TEAM=${REST%-*}`) — ces deux valeurs ne
          // servent QU'À nommer le build : l'équipe et l'env qui font foi sont
          // re-dérivés par le script, dans l'état MERGÉ. Écrit sans
          // `substring(0, -1)` : le Groovy d'origine levait une exception sur
          // une branche `onboard/x` sans tiret, là où le shell, lui, dégrade
          // proprement (ENV_NOT_OPEN dit alors la vraie cause).
          def ref = env.PR_BRANCH ?: ''
          if (ref.startsWith('onboard/')) {
            def rest = ref.substring('onboard/'.length())
            def i    = rest.lastIndexOf('-')
            def team = (i >= 0) ? rest.substring(0, i) : rest
            def envn = (i >= 0) ? rest.substring(i + 1) : rest
            // FORMAT À NE PAS CHANGER : « onboard <équipe>/<env> (PR #n) ». Le
            // harnais test-team-onboarding-chain.sh en EXTRAIT le numéro de PR
            // pour décider quelle pause lui appartient (lab PARTAGÉ : drainer
            // la pause d'autrui détruirait son approbation 4-yeux).
            currentBuild.displayName = "onboard ${team}/${envn} (PR #${env.PR_NUMBER ?: '?'})"
          } else {
            currentBuild.displayName = "hors onboard/* (PR #${env.PR_NUMBER ?: '?'})"
            echo "branche '${ref}' hors onboard/* — rien à appliquer."
          }
        }
      }
    }

    stage('Onboarder l\'équipe (identité nominative)') {
      // `beforeInput true` : la condition est évaluée AVANT la demande en
      // attente — une PR hors onboard/* ne réveille personne, le job se termine
      // vert sans avoir rien demandé ni rien appliqué (le `return` du Groovy).
      when {
        beforeInput true
        expression { (env.PR_BRANCH ?: '').startsWith('onboard/') }
      }

      // ── LA DEMANDE EN ATTENTE ────────────────────────────────────────────
      // Les valeurs saisies deviennent des variables d'environnement de
      // l'étape. Nommées V_USER / V_PASS (et non VAULT_USER /
      // VAULT_USER_PASSWORD) : c'est exactement ce que faisait le
      // `withEnv(["V_USER=…","V_PASS=…"])` du job Groovy, et c'est CE nom
      // intermédiaire qui permet de recopier puis `unset` le mot de passe DANS
      // le seul `sh` qui en a besoin — cf. le bloc d'apply.
      // Le nom de l'équipe et l'environnement figurent dans le NOM DU BUILD
      // (« onboard <équipe>/<env> »), posé par l'étape précédente.
      input {
        id 'onboard'
        message "Onboarder l'équipe portée par la PR fusionnée (voir le nom du build) ? Fournissez VOTRE identité d'annuaire (voie A) — elle sera confrontée à l'auteur du merge."
        parameters {
          string(name: 'V_USER', defaultValue: '',
                 description: "Login annuaire (ex. oscar) — DOIT être celui qui a fusionné la PR.")
          password(name: 'V_PASS', defaultValue: '',
                   description: "Mot de passe annuaire. ⚠ Ne PAS relancer en boucle après un refus (lockout AD).")
        }
      }

      // L'agent n'est alloué qu'APRÈS la réponse. Le checkout du dépôt portant
      // ce Jenkinsfile est implicite (Declarative) — d'où la disparition du
      // `git url: 'http://gitea:3000/ci/stoa-labs.git', branch: 'main'` du job
      // Groovy : l'URL et la branche vivent désormais dans la coquille XML
      // (CpsScmFlowDefinition), un seul endroit à changer chez le client.
      agent any

      steps {
        // ── 1. GARDE D'IDENTITÉ, AVANT tout apply ───────────────────────────
        // Relie l'identité PROUVÉE (le login Vault) à l'identité AFFIRMÉE par
        // le webhook (qui a mergé) et refuse si elles divergent, ou si le
        // valideur est le demandeur (MERGER_UNKNOWN / MERGER_MISMATCH /
        // FOUR_EYES_VIOLATION). Un build manuel n'a pas ces variables → refus.
        //
        // Les `withEnv(["G_MERGED_BY=…","G_REQUESTER=…","G_VAULT_USER=…"])` du
        // job Groovy ont disparu, PAS la discipline qu'ils portaient : en
        // déclaratif PR_MERGED_BY/PR_REQUESTER sont DÉJÀ dans l'environnement
        // (contribués par GenericTrigger) et V_USER y est posé par la directive
        // `input`. Ce qui comptait tient toujours : la chaîne `sh` est en
        // quotes SIMPLES, aucune valeur d'origine externe ne traverse une
        // interpolation Groovy pour atterrir dans du shell.
        dir('poc-control-plane-federation') {
          sh 'set +x; sh scripts/lib/assert-merge-identity.sh --merged-by "${PR_MERGED_BY:-}" --requester "${PR_REQUESTER:-}" --vault-user "${V_USER:-}"'
        }

        // ── 2. APPLY NOMINATIF ──────────────────────────────────────────────
        // Login Vault ET apply dans UN SEUL step `sh` : team-apply.sh hérite
        // VAULT_TOKEN_FILE en sous-processus, et le trap de révocation
        // (vault_trap_revoke, EXIT) ne révoque le token QU'APRÈS l'apply. Deux
        // steps `sh` séparés rouvriraient un process par step — le trap du
        // premier révoquerait le token AVANT que le second ne le consomme.
        withCredentials([string(credentialsId: env.GITEA_CREDENTIALS_ID, variable: 'GITEA_TOKEN')]) {
          dir('poc-control-plane-federation') {
            sh '''
              set +x
              export VAULT_USER="${V_USER:-}"
              export VAULT_USER_PASSWORD="${V_PASS:-}"
              # V_PASS ne doit PAS survivre au-delà de cette ligne : une variable
              # EXPORTÉE reste lisible dans /proc/PID/environ de TOUT process du
              # même nœud tant qu'elle est dans l'environnement du step — même
              # après avoir été recopiée dans VAULT_USER_PASSWORD, que
              # vault-login.sh `unset` après usage (Fix round 1 T7, panel,
              # miroir de Jenkinsfile.team-publish). `unset` ICI, avant tout
              # appel réseau (login inclus).
              unset V_PASS

              # shellcheck disable=SC1091
              . ci/lib/vault-login.sh
              # Trap armé AVANT le login : révoque + prouve la mort du token
              # MÊME si l'onboarding échoue.
              trap vault_trap_revoke EXIT
              # `RC=0; cmd || RC=$?` et NON `if ! cmd` : après un `!`, $? vaut 0.
              RC=0; vault_login_nominative || RC=$?
              if [ "$RC" != 0 ]; then
                [ "$RC" = 2 ] || exit 1     # identité fournie mais refusée = rouge
                echo "  (pas d'identité nominative → rien à appliquer)"; exit 0
              fi

              # Toute la substance est là-dedans : checkout au SHA de merge,
              # lecture de providers.<env>.yml dans l'état MERGÉ, création
              # idempotente du dépôt d'équipe + webhook team-publish, rôle
              # apim_team_onboard, commentaire de PR, re-pose des formulaires.
              # Le pipeline, lui, n'a fait que router des variables.
              # VAULT_TOKEN_FILE (token BRUT, cf. team-apply.sh) est exporté par
              # la lib ci-dessus et hérité en sous-processus (jamais en argv) ;
              # PR_BRANCH / PR_NUMBER / MERGE_SHA viennent du déclencheur,
              # GITEA_TOKEN du credential, le reste du bloc `environment`.
              bash scripts/team-apply.sh
            '''
          }
        }
      }
    }
  }

  // ── PARITÉ team-publish, dette I3 FERMÉE (2026-08-06). team-apply.sh commente
  // DÉJÀ la PR (✅/❌) MAIS seulement s'il a tourné : un échec AVANT lui (garde
  // d'identité refusée, pause abandonnée/expirée, agent injoignable) laissait la
  // PR d'onboarding MUETTE. Ce `post{always}` pose un commentaire de STATUT BUILD
  // dans TOUS les cas, sous un marqueur DISTINCT (`team-apply-build`, jamais celui
  // de team-apply.sh) et idempotent via gitea-pr-comment.sh — les deux commentaires
  // coexistent sans que l'un n'écrase l'autre. `agent none` au niveau pipeline →
  // `node` explicite + `checkout scm` : ce bloc n'hérite ni exécuteur ni workspace.
  post {
    always {
      node("${env.POST_AGENT_LABEL ?: ''}") {
        checkout scm
        withCredentials([string(credentialsId: env.GITEA_CREDENTIALS_ID, variable: 'GITEA_TOKEN')]) {
          withEnv(["BUILD_RESULT=${currentBuild.currentResult}"]) {
            dir('poc-control-plane-federation') {
              sh '''
                set +x
                # La PR d'onboarding vit sur le dépôt PLATEFORME (GIT_REPO), pas
                # sur un dépôt d'équipe : team-apply est déclenché par le merge
                # d'une PR onboard/* de ci/stoa-labs.
                if [ -z "${GIT_REPO:-}" ] || [ -z "${PR_NUMBER:-}" ]; then
                  echo "commentaire de statut impossible (GIT_REPO/PR_NUMBER absents)"
                  exit 0
                fi
                # Une PR hors onboard/* n'a rien déclenché (étape SAUTÉE) : ne pas commenter.
                case "${PR_BRANCH:-}" in
                  onboard/*) ;;
                  *) echo "(branche hors onboard/* — aucun statut à commenter)"; exit 0 ;;
                esac
                # Corps SANS accents : ils traversent l'agent, un POST JSON et Gitea.
                # BUILD_URL n'existe que si l'URL racine Jenkins est configurée (pas
                # sur ce lab) → repli sur job#numéro, toujours disponible.
                BUILD_REF="${BUILD_URL:-}"
                [ -n "$BUILD_REF" ] || BUILD_REF="${JOB_NAME:-team-apply} #${BUILD_NUMBER:-?}"
                BODYFILE="$(mktemp)"
                case "${BUILD_RESULT:-FAILURE}" in
                  SUCCESS)
                    printf "team-apply (statut build) : build termine sans erreur -- voir le commentaire team-apply pour le resultat de l onboarding.\\n" > "$BODYFILE" ;;
                  ABORTED)
                    printf "team-apply (statut build) : la demande en attente a ete ABANDONNEE (ou a expire) -- RIEN n a ete onboarde. Rejouer le webhook pour rouvrir la demande. Build : %s\\n" "$BUILD_REF" > "$BODYFILE" ;;
                  *)
                    printf "team-apply (statut build) : le build a echoue avant ou pendant l onboarding. Si la garde d identite a refuse ou si la pause a ete abandonnee, RIEN n a ete onboarde -- voir le commentaire team-apply s il existe, sinon le log : %s\\n" "$BUILD_REF" > "$BODYFILE" ;;
                esac
                GIT_REPO="$GIT_REPO" PR_NUMBER="$PR_NUMBER" \
                  COMMENT_MARKER="<!-- team-apply-build -->" \
                  COMMENT_BODY_FILE="$BODYFILE" bash scripts/lib/gitea-pr-comment.sh \
                  || echo "AVERTISSEMENT: commentaire de statut (post) en echec"
                rm -f "$BODYFILE"
              '''
            }
          }
        }
      }
    }
  }
}
