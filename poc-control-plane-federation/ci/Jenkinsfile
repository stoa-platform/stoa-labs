// CI bank-réaliste : push Git -> webhook -> Jenkins -> labctl (Define Once).
// Le build de labctl est AIR-GAPPED (vendor/ + GOPROXY=off) ; l'apply tape les
// gateways par leurs noms docker INTERNES (zéro flux entrant depuis l'extérieur).
//
// CE PIPELINE EST LE PIPELINE HORS-PROD (ADR-075) : déclenché par webhook
// (token stoa-ci), il converge dev -> rec -> int via les proxies admin
// wm-admin-{env}. La prod a SON pipeline (ci/Jenkinsfile.prod, AUCUN trigger,
// gate Git-natif promotion+ITSM+4-yeux) ; le rollback le sien
// (ci/Jenkinsfile.rollback). Voir ci/README.md + adr/adr-075.
pipeline {
  agent any
  // Builds SÉRIALISÉS : le token Bearer des proxies vit à un chemin FIXE
  // (/tmp/stoa-wm-admin-token, déclaré par les manifests envs/) — deux builds
  // concurrents se le voleraient (course observée builds #23/#24). Un
  // déploiement à la fois est de toute façon le régime bancaire.
  options { disableConcurrentBuilds() }
  // NB: pas d'options { timestamps() } — exige le plugin timestamper (absent
  // de l'image). Bug du scaffold détecté au premier run (Phase 0).
  // Webhook Gitea → /generic-webhook-trigger/invoke?token=stoa-ci (exempt de
  // crumb CSRF, contrairement à /job/…/build?token=). Le trigger s'enregistre
  // au premier build du job (lancer le build #1 manuellement à la création).
  triggers { GenericTrigger(token: 'stoa-ci', printContributedVariables: false, printPostContent: false) }
  environment {
    // Préfixe du livrable DANS le dépôt (2026-09-03) : le seul endroit qui le
    // nomme. « . » = le livrable EST la racine (une valeur VIDE ne traverse pas
    // Jenkins : elle arrive absente et reprendrait ce défaut).
    GIT_SUBDIR           = "${env.GIT_SUBDIR ?: 'poc-control-plane-federation'}"
    GOPROXY = 'off'; GOFLAGS = '-mod=vendor'; GOSUMDB = 'off'
    // É0 — auth Git : URL du repo governance + credential Jenkins OPTIONNEL,
    // surchargeables au niveau job (défauts = Gitea anonyme du PoC). Chez un
    // client : GOVERNANCE_GIT_URL = remote d'entreprise, GIT_CREDENTIALS_ID =
    // credential usernamePassword (PAT) — le clone passe par GIT_ASKPASS,
    // le secret ne touche ni l'URL, ni argv, ni le log.
    GOVERNANCE_GIT_URL = "${env.GOVERNANCE_GIT_URL ?: 'http://gitea:3000/ci/governance.git'}"
    GIT_CREDENTIALS_ID = "${env.GIT_CREDENTIALS_ID ?: ''}"
  }
  stages {
    stage('Build labctl (air-gapped, vendored)') {
      steps {
        dir('poc-control-plane-federation/labctl') {
          sh 'go version'
          sh 'go build -trimpath -o "$WORKSPACE/labctl" .'   // aucun accès réseau
        }
      }
    }
    stage('Apply — Define Once, Expose Everywhere') {
      steps {
        dir(env.GIT_SUBDIR) {
          // GitOps : 1 contrat OpenAPI + targets.cluster.yaml en git -> fédéré sur les 3 gateways.
          // NON-BLOQUANT (catchError → UNSTABLE) : ce stage est la preuve legacy
          // tri-gateway, PAS la chaîne multi-env (webMethods-only, stages suivants).
          // WSO2 4.x a un quirk connu : à la rotation des révisions (max 5), la
          // suppression de la plus ancienne peut rester coincée ("Failed to delete
          // API revision registry artifacts", build #25) — un état à nettoyer À LA
          // MAIN côté WSO2, qui ne doit pas bloquer les déploiements wM gated.
          catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
            sh '"$WORKSPACE/labctl" apply -f targets.cluster.yaml'
          }
        }
      }
    }
    // ADR-072/075 — Médiation control-plane MULTI-ENV : la CI applique les
    // contrats UAC du repo governance sur la chaîne HORS-PROD dev→rec→int,
    // SCOPÉ à un tenant, ATTRIBUÉ et AUDITÉ. Ce pipeline est le pipeline
    // HORS-PROD : il ne porte AUCUN chemin vers la prod (le client ci-horsprod
    // n'a pas le scope deploy:prod ; la prod est ci/Jenkinsfile.prod, gated).
    //
    // Par env : apply-uac --env $E -f envs/$E/targets.cluster.yaml — l'adminUrl
    // est le PROXY allowlist wm-admin-{env} du wM réel (le mock de l'env vit
    // sur le réseau nonprod interne, Jenkins ne l'atteint JAMAIS en direct).
    // Le token Bearer présenté au proxy = ci-horsprod (client_credentials,
    // scopes deploy:dev+rec+int par défaut), écrit 0600 au chemin
    // bearerTokenFile attendu par les manifests (/tmp/stoa-wm-admin-token).
    //
    // Le GATE est GIT : un env sans deploy.{env}.yaml mergé dans le repo
    // governance est SKIPPÉ par apply-uac (narration, pas d'erreur) — la
    // promotion d'un env = un merge, jamais un paramètre de job.
    //
    stage('Checkout governance (GitOps source)') {
      steps {
        dir(env.GIT_SUBDIR) {
          // Clone COMPLET (pas de --depth 1) : le pinning de version lit le
          // contrat au SHA capturé par la promotion (git show <commit>:…) — un
          // clone shallow ne porte pas l'historique et casse ResolvePinned.
          // GIT_CREDENTIALS_ID non vide -> créds injectées via GIT_ASKPASS.
          script { cloneGovernance() }
        }
      }
    }
    // Credentials Jenkins requis (en prod : émis depuis Vault, rotés) :
    //   - vault-ci-secret-id   : secret_id AppRole ci-pipeline (seul secret)
    //   - GIT_CREDENTIALS_ID   : optionnel (remote governance authentifié, É0)
    stage('Mediation — apply-uac dev→rec→int (ADR-072/075)') {
      environment {
        // Le token a iss=localhost:8480 (frontend KC figé), mais le JWKS est
        // fetché EN RÉSEAU sur keycloak:8080 (split-horizon).
        KEYCLOAK_URL                = "${env.KEYCLOAK_URL ?: 'http://localhost:8480'}"
        KEYCLOAK_JWKS_URL           = "${env.KEYCLOAK_JWKS_URL ?: 'http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/certs'}"
        LABCTL_AUDIENCE             = "${env.LABCTL_AUDIENCE ?: 'onboarding-api'}"
        OPENSEARCH_URL              = "${env.OPENSEARCH_URL ?: 'https://opensearch:9200'}"
        OPENSEARCH_USER             = "${env.OPENSEARCH_USER ?: 'admin'}"
        OPENSEARCH_INSECURE         = "${env.OPENSEARCH_INSECURE ?: 'true'}"
        OTEL_EXPORTER_OTLP_ENDPOINT = "${env.OTEL_EXPORTER_OTLP_ENDPOINT ?: 'http://otel-lgtm:4318'}"
        APPLY_TENANT                = "${env.APPLY_TENANT ?: 'banking-demo'}"
        VAULT_ADDR                  = "${env.VAULT_ADDR ?: 'http://vault:8200'}"
        // VAULT_ROLE_ID = l'IDENTITÉ AppRole (NON-SECRET, comme un username) — c'est
        // pourquoi elle peut vivre en clair ici. Le secret_id (credential ci-dessous)
        // est le SEUL vrai secret, court (~10min), rotable. Login -> token ÉPHÉMÈRE
        // (TTL 3min) scopé aux policies stoa-ci+stoa-labctl. Plus de root token (ADR-074).
        // NB PoC : ce role_id est propre à l'instance Vault dev courante ; s'il redémarre,
        // re-régler via `scripts/setup-vault-approle.sh --mint ci-pipeline` (1ère valeur).
        VAULT_ROLE_ID               = "${env.VAULT_ROLE_ID ?: 'fa09b310-79a7-8845-609b-9b6090bcd53b'}"
      }
      steps {
        dir(env.GIT_SUBDIR) {
          withCredentials([string(credentialsId: 'vault-ci-secret-id', variable: 'VAULT_SECRET_ID')]) {
            sh '''
              set +x          # NEVER echo: secret_id, vault token, OAuth tokens must not reach the console
              set -eu
              : "${VAULT_ROLE_ID:?VAULT_ROLE_ID (non-secret AppRole id) doit être configuré au niveau Jenkins}"
              # tmpfiles 0600 créés EN AMONT pour que le trap ne référence jamais un var unset (set -u)
              # WMTOKFILE est FIXE (/tmp/stoa-wm-admin-token) : c'est le bearerTokenFile
              # déclaré par envs/*/targets.cluster.yaml — nettoyé par le trap.
              VTOKFILE=$(mktemp); TOKFILE=$(mktemp); WMTOKFILE=/tmp/stoa-wm-admin-token
              trap 'rm -f "$VTOKFILE" "$TOKFILE" "$WMTOKFILE"' EXIT
              # 0) LOGIN AppRole (role_id config + secret_id court) -> token ÉPHÉMÈRE
              VTOK=$(curl -sf -X POST "$VAULT_ADDR/v1/auth/approle/login" \
                -d "{\\"role_id\\":\\"$VAULT_ROLE_ID\\",\\"secret_id\\":\\"$VAULT_SECRET_ID\\"}" \
                | sed -n 's/.*"client_token":"\\([^"]*\\)".*/\\1/p')
              [ -n "$VTOK" ] || { echo 'vault approle login failed'; exit 1; }
              ( umask 077; printf %s "$VTOK" > "$VTOKFILE" )
              # 1) secrets pipeline lus avec le token éphémère. NB : la policy stoa-ci
              #    ne lit PAS secret/stoa/envs/+/wm-admin (creds admin des mocks) — la
              #    CI hors-prod ne voit JAMAIS un credential gateway, seulement les
              #    secrets de SES comptes de service (test négatif 403 dans la démo).
              CI_SECRET=$(curl -sf -H "X-Vault-Token: $VTOK" "$VAULT_ADDR/v1/secret/data/stoa/ci" \
                | sed -n 's/.*"ciApplierSecret":"\\([^"]*\\)".*/\\1/p')
              HP_SECRET=$(curl -sf -H "X-Vault-Token: $VTOK" "$VAULT_ADDR/v1/secret/data/stoa/ci" \
                | sed -n 's/.*"ciHorsprodSecret":"\\([^"]*\\)".*/\\1/p')
              export OPENSEARCH_PASSWORD=$(curl -sf -H "X-Vault-Token: $VTOK" "$VAULT_ADDR/v1/secret/data/stoa/opensearch" \
                | sed -n 's/.*"adminPassword":"\\([^"]*\\)".*/\\1/p')
              [ -n "$CI_SECRET" ] && [ -n "$HP_SECRET" ] && [ -n "$OPENSEARCH_PASSWORD" ] || { echo 'vault fetch failed (setup-vault-envs.sh lancé ?)'; exit 1; }
              unset VTOK
              # 2) mint des DEUX comptes de service (client_credentials) — le repo
              #    governance a été cloné par le stage Checkout (auth Git É0) :
              #    - ci-applier   -> médiation apply-uac (rôle cp-applier + tenant, ADR-072)
              #    - ci-horsprod  -> Bearer présenté aux proxies wm-admin-{env}
              #      (scopes deploy:dev+rec+int par défaut, JAMAIS deploy:prod, ADR-075)
              [ -d governance/.git ] || { echo 'governance/ absent (stage Checkout KO ?)'; exit 1; }
              CI_TOKEN=$(curl -sf -X POST http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/token \
                -d client_id=ci-applier -d client_secret="$CI_SECRET" -d grant_type=client_credentials \
                | sed -n 's/.*"access_token":"\\([^"]*\\)".*/\\1/p')
              WM_TOKEN=$(curl -sf -X POST http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/token \
                -d client_id=ci-horsprod -d client_secret="$HP_SECRET" -d grant_type=client_credentials \
                | sed -n 's/.*"access_token":"\\([^"]*\\)".*/\\1/p')
              [ -n "$CI_TOKEN" ] && [ -n "$WM_TOKEN" ] || { echo 'no CI token (setup-ci-horsprod.sh lancé ?)'; exit 1; }
              # 3) tokens via fichiers 0600 (jamais env/argv/log) ; labctl lit les creds
              #    gateway depuis Vault avec le MÊME token éphémère (VAULT_TOKEN_FILE).
              ( umask 077; printf %s "$CI_TOKEN" > "$TOKFILE"; printf %s "$WM_TOKEN" > "$WMTOKFILE" )
              unset CI_TOKEN WM_TOKEN CI_SECRET HP_SECRET
              # 4) chaîne hors-prod, DÉRIVÉE de governance/environments.yaml —
              #    la MÊME source que celle dont apply-uac et governance-api
              #    tirent leurs portes. Était `for E in dev rec int` en dur :
              #    ajouter un palier obligeait à éditer ce fichier, et l'oubli
              #    ne se voyait nulle part (le palier était juste... absent).
              #
              #    HORS-PROD = la chaîne PRIVÉE DE SON TERMINUS. La barrière est
              #    donc STRUCTURELLE et non nominale : ce pipeline ne peut pas
              #    servir le dernier palier même si quelqu'un le renommait.
              #    (Défense en profondeur : le client ci-horsprod n'a de toute
              #    façon pas le scope du terminus — cf. setup-ci-horsprod.sh.)
              #
              #    ⚠ dash, pas bash : pas de tableaux, on reste en découpage de
              #    mots sur une ligne — d'où le `for E in $CHAIN` ci-dessous.
              #    FAIL-CLOSED : chaîne illisible => on sort, on ne devine pas.
              CHAIN=$(python3 - governance/environments.yaml <<'PYCHAIN'
import sys, yaml
d = yaml.safe_load(open(sys.argv[1])) or {}
e = d.get("environments") or []
if len(e) < 2:
    sys.exit("environments.yaml: chaine trop courte ou absente")
print(" ".join(e[:-1]))
PYCHAIN
              ) || { echo "chaine d environnements illisible (governance/environments.yaml)"; exit 1; }
              echo "=== chaine hors-prod deduite : $CHAIN ==="
              # Gate GIT inchangé : un env sans deploy.{env}.yaml mergé est
              # SKIPPÉ par apply-uac (narration) ; verify par env (get apis via
              # le MÊME proxy/Bearer).
              for E in $CHAIN; do
                echo "=== env $E — apply-uac (proxy wm-admin-$E) ==="
                LABCTL_TOKEN_FILE="$TOKFILE" VAULT_TOKEN_FILE="$VTOKFILE" "$WORKSPACE/labctl" apply-uac \
                  --repo governance --env "$E" --tenant "$APPLY_TENANT" -f "envs/$E/targets.cluster.yaml"
                echo "=== env $E — verify (catalogue) ==="
                "$WORKSPACE/labctl" get apis -f "envs/$E/targets.cluster.yaml"
              done
            '''
          }
        }
      }
    }
    stage('Verify — catalogue unifié') {
      steps {
        dir(env.GIT_SUBDIR) {
          sh '"$WORKSPACE/labctl" get apis -f targets.cluster.yaml'
        }
      }
    }
  }
  post {
    success { echo '✓ API fédérée + médiation control-plane (scoped/attribué/audité/tracé) depuis 1 commit.' }
    failure { echo '✗ pipeline KO — voir le log de l’étape.' }
  }
}

// É0 — clone du repo governance ($GOVERNANCE_GIT_URL) avec auth Git OPTIONNELLE.
// GIT_CREDENTIALS_ID vide (défaut PoC) -> clone anonyme, comportement inchangé.
// GIT_CREDENTIALS_ID posé (client) -> credential usernamePassword injecté via un
// helper GIT_ASKPASS éphémère 0700 qui RELIT l'env : le secret n'apparaît jamais
// dans l'URL du remote, ni en argv (visible /proc), ni au log (masque
// withCredentials). Clone toujours COMPLET (ResolvePinned exige l'historique).
def cloneGovernance() {
  def clone = {
    sh '''
      set -eu
      rm -rf governance
      if [ -n "${GIT_USER:-}" ]; then
        ASKPASS="$WORKSPACE/.git-askpass"
        printf '#!/bin/sh\\ncase "$1" in Username*) printf %%s "$GIT_USER" ;; *) printf %%s "$GIT_PASS" ;; esac\\n' > "$ASKPASS"
        chmod 700 "$ASKPASS"
        GIT_ASKPASS="$ASKPASS" GIT_TERMINAL_PROMPT=0 git clone "$GOVERNANCE_GIT_URL" governance
        rm -f "$ASKPASS"
      else
        GIT_TERMINAL_PROMPT=0 git clone "$GOVERNANCE_GIT_URL" governance
      fi
    '''
  }
  if (env.GIT_CREDENTIALS_ID?.trim()) {
    withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID,
                                      usernameVariable: 'GIT_USER',
                                      passwordVariable: 'GIT_PASS')]) { clone() }
  } else {
    clone()
  }
}
