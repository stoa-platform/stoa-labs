// ci/Jenkinsfile.publish-api — PUBLICATION D'API (PRODUCTEUR, ADR-076/075).
//
// Même modèle que ci/Jenkinsfile.selfservice, côté producteur : le CI lance le
// RÔLE ANSIBLE `apim_publish_api` (import OpenAPI multipart + activate + inbound).
// Aucun binaire/script AI-co-développé dans la chaîne cible client.
//
//   push/PR ──webhook──▶ PLAN   : identité de JOB, LECTURE SEULE — valide le
//                                 manifeste + ansible --syntax-check.
//              humain ──▶ APPLY  : build PARAMÉTRÉ, identité NOMINATIVE (voie A :
//                                 user + mot de passe annuaire ; voie B : JWT
//                                 Keycloak) → le rôle lit les creds admin dans
//                                 Vault et publie + verify.
//
// Login, révocation et preuve de mort du token : ci/lib/vault-login.sh (ADR-078 §2).
pipeline {
  agent any
  options { disableConcurrentBuilds() }

  parameters {
    string(name: 'MANIFEST', defaultValue: 'clients/_example/apis/accounts-read.publish.yml',
           description: "Manifeste de publication (vars du rôle : apim_api).")
    // Env cible : sélectionne per_env[ENVIRONMENT] (inbound issuer/JWKS/audience par
    // env) ET pose X-Environment vers le proxy d'admin. Vide = API mono-env.
    choice(name: 'ENVIRONMENT', choices: ['dev', 'rec', 'int', 'prod'],
           description: "Environnement cible (inbound par env + header X-Environment).")
    // VOIE A (V1, ADR-078 §3) — identité d'annuaire saisie à l'apply, jamais persistée.
    string(name: 'VAULT_USER', defaultValue: '',
           description: "Identité NOMINATIVE (voie A) : votre login annuaire (sAMAccountName, UPN user@domaine, ou DOMAIN\\\\user). Vide sur le PLAN.")
    password(name: 'VAULT_USER_PASSWORD', defaultValue: '',
             description: "Mot de passe annuaire, saisi À CHAQUE apply. ⚠ Ne PAS relancer en boucle après un refus (lockout AD). NB : le bouton « Change Password » est un libellé Jenkins (SECURITY-1721) — il signifie « saisir la valeur du champ », RIEN ne modifie votre mot de passe annuaire ; cliquez-le puis tapez votre mot de passe.")
    // VOIE B (cible SSO, ADR-077) — prioritaire si fournie.
    string(name: 'USER_VAULT_JWT', defaultValue: '',
           description: "Identité NOMINATIVE (voie B) : JWT court aud=vault. Prioritaire sur la voie A. Vide sur le PLAN.")
  }

  triggers { GenericTrigger(token: 'stoa-publish-api-plan',
             genericVariables: [[key: 'MANIFEST', value: '$.manifest']],
             printContributedVariables: false, printPostContent: false) }

  environment {
    VAULT_ADDR        = "${env.VAULT_ADDR ?: 'http://vault:8200'}"
    // `ldap` chez le client (AD), `userpass` en lab : MÊME requête REST, seul le mount change.
    VAULT_USER_AUTH_MOUNT = "${env.VAULT_USER_AUTH_MOUNT ?: 'ldap'}"
    APIM_API_BASE     = "${env.APIM_API_BASE  ?: 'http://webmethods-real:5555/rest/apigateway'}"
    APIM_DATA_BASE    = "${env.APIM_DATA_BASE ?: 'http://webmethods-real:5555/gateway'}"
    APIM_WM_CREDS_SUB = "${env.APIM_WM_CREDS_SUB ?: 'deploy/banking-demo/wm-admin'}"
    INVENTORY         = 'ansible/inventory.lab.ini'
  }

  stages {

    stage('Plan — valider le contrat (lecture seule, identité de job)') {
      steps {
        dir('poc-control-plane-federation') {
          sh '''
            set -eu
            MANIFEST="${MANIFEST:-clients/_example/apis/accounts-read.publish.yml}"
            echo "=== PLAN : manifeste ${MANIFEST} ==="
            test -f "$MANIFEST" || { echo "manifeste introuvable : $MANIFEST"; exit 1; }
            grep -qE '^[[:space:]]*name:' "$MANIFEST" && grep -qE '^[[:space:]]*contract:' "$MANIFEST" \
              || { echo "manifeste incomplet (name/contract requis)"; exit 1; }
            ansible-playbook -i "$INVENTORY" ansible/publish-api.yml --syntax-check
            echo "  ✓ manifeste valide + playbook syntaxiquement correct (aucune mutation)"
          '''
        }
      }
    }

    stage('Apply — publier + verify via le rôle Ansible (identité nominative → Vault)') {
      steps {
        dir('poc-control-plane-federation') {
          sh '''
            set +x
            set -eu
            MANIFEST="${MANIFEST:-clients/_example/apis/accounts-read.publish.yml}"

            # IDENTITÉ NOMINATIVE → TOKEN VAULT (voie B si JWT fourni, sinon voie A).
            . ci/lib/vault-login.sh
            # Trap armé AVANT le login : révoque + prouve la mort MÊME si la
            # publication échoue (un revoke en dernière instruction est sauté par `set -e`).
            trap vault_trap_revoke EXIT
            # `RC=0; cmd || RC=$?` et NON `if ! cmd` : après un `!`, $? vaut 0.
            RC=0; vault_login_nominative || RC=$?
            if [ "$RC" != 0 ]; then
              [ "$RC" = 2 ] || exit 1     # identité fournie mais refusée = rouge
              echo "  (pas d'identité nominative → PLAN-only, apply sauté)"; exit 0
            fi

            # Manifeste en CHEMIN (apim_ss_manifest → include_vars), PAS `-e @` :
            # un extra-var masquerait la fusion per_env (précédence Ansible).
            ansible-playbook -i "$INVENTORY" ansible/publish-api.yml \
              -e apim_ss_manifest="$MANIFEST" \
              -e apim_ss_env="${ENVIRONMENT:-}" \
              -e apim_ss_api_base="$APIM_API_BASE" \
              -e apim_ss_data_base="$APIM_DATA_BASE" \
              -e apim_ss_vault_wm_creds_sub="$APIM_WM_CREDS_SUB"

            ansible-playbook -i "$INVENTORY" ansible/publish-api-verify.yml \
              -e apim_ss_manifest="$MANIFEST" \
              -e apim_ss_env="${ENVIRONMENT:-}" \
              -e apim_ss_api_base="$APIM_API_BASE" \
              -e apim_ss_data_base="$APIM_DATA_BASE" \
              -e apim_ss_vault_wm_creds_sub="$APIM_WM_CREDS_SUB"

            # Le token nominatif meurt avec le build : révocation + PREUVE DE MORT
            # (lookup-self -> 403) exécutées par le trap, succès comme échec.
          '''
        }
      }
    }
  }

  post {
    success { echo '✓ API publiée + vérifiée par le RÔLE ANSIBLE, sous identité nominative. Zéro binaire/script, zéro credential stocké côté CI.' }
    failure { echo '✗ pipeline KO — voir le log de l\'étape.' }
  }
}
