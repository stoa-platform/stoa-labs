// ci/Jenkinsfile.prod — pipeline PROD (ADR-075). AUCUN trigger : lancé À LA MAIN
// (Build with Parameters) par l'opérateur de mise en prod, avec l'ID de la
// promotion approuvée. Le GATE est GIT-NATIF : tout est relu depuis le repo
// governance AVANT le moindre dispatch — le job ne fait confiance ni à ses
// paramètres ni à un état externe, seulement à ce qui est mergé et approuvé.
//
// Conditions (fail-closed, error() avant tout dispatch) :
//   - promotions/banking-demo/$PROMOTION_ID.yaml : status=approved, to=prod
//   - 4-yeux : approved_by != requested_by
//   - change ITSM référencé (change_ref) + preuve de validation (pv_ref) non vides
//   - deploy.prod.yaml du slug existe avec un commit PINNÉ (version exacte
//     déployée = celle approuvée, pas « le dernier main »)
//
// Le client ci-horsprod n'a PAS le scope deploy:prod : ce pipeline applique en
// ADMIN DIRECT sur le wM réel (envs/prod/targets.cluster.yaml), creds résolus
// depuis Vault (pattern AppRole existant, ADR-074). Rollback : Jenkinsfile.rollback.
pipeline {
  agent any
  // Builds SÉRIALISÉS : un acte prod à la fois (et le chemin de token fixe
  // partagé interdit la concurrence — cf. ci/Jenkinsfile).
  options { disableConcurrentBuilds() }
  // PAS de triggers {} : prod ne part JAMAIS d'un webhook.
  parameters {
    string(name: 'PROMOTION_ID', defaultValue: '', description: 'ID de la promotion int→prod approuvée (promotions/banking-demo/{id}.yaml)')
    // Identité NOMINATIVE de l'opérateur de mise en prod (voie A, ADR-078 §3).
    // Laissées vides → repli AppRole : le job s'exécute sous une identité de
    // MACHINE et l'acte prod n'est imputable à personne. C'est le comportement
    // historique, conservé pour ne rien casser — pas la cible.
    // ⚠ Le token nominatif doit porter une policy couvrant les secrets de
    // PLATEFORME (stoa/ci, stoa/opensearch, stoa/gateways/*), pas seulement un
    // périmètre deploy-<tenant> : c'est la policy `operator-deploy`, dont
    // l'octroi à des humains est une DÉCISION CLIENT (ADR-078 § Décisions, n°9).
    //
    // ⚠ G2 (ADR-084) : la porte prod déclare deployerGroup=apim-operator-prod.
    // Le repli AppRole ci-dessous est donc REFUSÉ par apply-uac
    // (DEPLOYER_GROUP_REQUIRED : le token AppRole ne porte pas operator-deploy).
    // Déployer prod exige un humain du groupe — l'imputabilité n'est plus un
    // vœu, c'est la déclaration qui la force. Pour un compte de service
    // d'exception : grant EXPLICITE de la policy (geste exploitant).
    string(name: 'VAULT_USER', defaultValue: '',
           description: "Identité NOMINATIVE de l'opérateur : login annuaire. Vide = repli AppRole (acte non imputable).")
    password(name: 'VAULT_USER_PASSWORD', defaultValue: '',
             description: "Mot de passe annuaire, saisi à chaque mise en prod. ⚠ Ne pas rejouer après un refus (lockout AD). NB : le bouton « Change Password » est un libellé Jenkins (SECURITY-1721) — il signifie « saisir la valeur du champ », RIEN ne modifie votre mot de passe annuaire ; cliquez-le puis tapez votre mot de passe.")
  }
  environment {
    // Préfixe du livrable DANS le dépôt (2026-09-03) : le seul endroit qui le
    // nomme. « . » = le livrable EST la racine (une valeur VIDE ne traverse pas
    // Jenkins : elle arrive absente et reprendrait ce défaut).
    GIT_SUBDIR           = "${env.GIT_SUBDIR ?: 'poc-control-plane-federation'}"
    GOPROXY = 'off'; GOFLAGS = '-mod=vendor'; GOSUMDB = 'off'
    // É0 — auth Git (cf. ci/Jenkinsfile) : défauts PoC anonymes, surchargeables
    // au niveau job ; GIT_CREDENTIALS_ID non vide -> clone via GIT_ASKPASS.
    GOVERNANCE_GIT_URL = "${env.GOVERNANCE_GIT_URL ?: 'http://gitea:3000/ci/governance.git'}"
    GIT_CREDENTIALS_ID = "${env.GIT_CREDENTIALS_ID ?: ''}"
    KEYCLOAK_URL                = "${env.KEYCLOAK_URL ?: 'http://localhost:8480'}"
    KEYCLOAK_JWKS_URL           = "${env.KEYCLOAK_JWKS_URL ?: 'http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/certs'}"
    LABCTL_AUDIENCE             = "${env.LABCTL_AUDIENCE ?: 'onboarding-api'}"
    OPENSEARCH_URL              = "${env.OPENSEARCH_URL ?: 'https://opensearch:9200'}"
    OPENSEARCH_USER             = "${env.OPENSEARCH_USER ?: 'admin'}"
    OPENSEARCH_INSECURE         = "${env.OPENSEARCH_INSECURE ?: 'true'}"
    OTEL_EXPORTER_OTLP_ENDPOINT = "${env.OTEL_EXPORTER_OTLP_ENDPOINT ?: 'http://otel-lgtm:4318'}"
    APPLY_TENANT                = "${env.APPLY_TENANT ?: 'banking-demo'}"
    // ITSM du re-check LIVE au dispatch (A6) : le stage 'Gate LIVE' ET la couche
    // labctl apply-uac (fail-closed) le relisent à l'instant du dispatch.
    ITSM_URL                    = "${env.ITSM_URL ?: 'http://itsm-mock:8788'}"
    VAULT_ADDR                  = "${env.VAULT_ADDR ?: 'http://vault:8200'}"
    // Identité AppRole non-secrète (cf. Jenkinsfile hors-prod) ; le secret_id
    // est le credential Jenkins vault-ci-secret-id.
    VAULT_ROLE_ID               = "${env.VAULT_ROLE_ID ?: 'fa09b310-79a7-8845-609b-9b6090bcd53b'}"
  }
  stages {
    stage('Build labctl (air-gapped, vendored)') {
      steps {
        dir('poc-control-plane-federation/labctl') {
          sh 'go version'
          sh 'go build -trimpath -o "$WORKSPACE/labctl" .'   // aucun accès réseau
        }
      }
    }
    stage('Checkout governance (GitOps source)') {
      steps {
        dir(env.GIT_SUBDIR) {
          // Clone COMPLET (pas de --depth 1) : le pinning de version lit le
          // contrat au SHA capturé par la promotion (git show <commit>:…) — un
          // clone shallow ne porte pas l'historique et casse ResolvePinned.
          // GIT_CREDENTIALS_ID non vide -> créds injectées via GIT_ASKPASS (É0).
          script { cloneGovernance() }
        }
      }
    }
    stage('Gate Git-natif — promotion approuvée + ITSM + 4-yeux + commit pinné') {
      steps {
        dir(env.GIT_SUBDIR) {
          sh '''
            set -eu
            [ -n "$PROMOTION_ID" ] || { echo 'GATE: PROMOTION_ID requis'; exit 1; }
            [ -d governance/.git ] || { echo 'GATE: governance/ absent (stage Checkout KO ?)'; exit 1; }
            P="governance/promotions/banking-demo/$PROMOTION_ID.yaml"
            [ -f "$P" ] || { echo "GATE: promotion $PROMOTION_ID introuvable (non mergée ?)"; exit 1; }
            # yget <clé> <fichier> — YAML plat clé: valeur (le format des markers
            # de promotion governance-api), sans dépendance python sur l'agent.
            yget() { sed -n "s/^$1:[[:space:]]*//p" "$2" | head -1 | tr -d '"'; }
            STATUS=$(yget status "$P"); TO=$(yget to "$P"); SLUG=$(yget slug "$P")
            REQ=$(yget requested_by "$P"); APPR=$(yget approved_by "$P")
            CHG=$(yget change_ref "$P");  PV=$(yget pv_ref "$P")
            echo "promotion $PROMOTION_ID: slug=$SLUG to=$TO status=$STATUS requested_by=$REQ approved_by=$APPR change_ref=$CHG pv_ref=$PV"
            [ "$STATUS" = approved ] || { echo "GATE: status=$STATUS (attendu approved)"; exit 1; }
            [ "$TO" = prod ]         || { echo "GATE: to=$TO (attendu prod)"; exit 1; }
            [ -n "$SLUG" ]           || { echo 'GATE: slug vide'; exit 1; }
            # 4-yeux : l'approbateur ne peut pas être le demandeur (déjà enforce
            # par governance-api SELF_APPROVAL_BLOCKED — re-vérifié ici car le
            # gate est GIT, pas une confiance dans l'API).
            [ -n "$REQ" ] && [ -n "$APPR" ] && [ "$REQ" != "$APPR" ] \
              || { echo "GATE: 4-yeux KO (requested_by=$REQ approved_by=$APPR)"; exit 1; }
            [ -n "$CHG" ] || { echo 'GATE: change_ref (ITSM) vide'; exit 1; }
            [ -n "$PV" ]  || { echo 'GATE: pv_ref (preuve de validation) vide'; exit 1; }
            # Version PINNÉE : deploy.prod.yaml mergé, champ commit non vide.
            D="governance/tenants/banking-demo/apis/$SLUG/deploy.prod.yaml"
            [ -f "$D" ] || { echo "GATE: $D absent (la promotion n'a pas mergé deploy.prod.yaml)"; exit 1; }
            COMMIT=$(yget commit "$D")
            [ -n "$COMMIT" ] || { echo 'GATE: deploy.prod.yaml sans commit pinné'; exit 1; }
            echo "GATE OK — $SLUG → prod @ $COMMIT (change $CHG, PV $PV, approuvé par $APPR)"
          '''
        }
      }
    }
    stage('Gate LIVE — ITSM re-checké au DISPATCH (anti-TOCTOU, A6)') {
      steps {
        dir(env.GIT_SUBDIR) {
          // Le gate Git-natif ci-dessus a validé l'état MERGÉ (approbation au
          // moment du merge). Ici on re-valide l'état LIVE de l'ITSM À L'INSTANT
          // du dispatch : un change approuvé au merge puis RÉVOQUÉ avant ce point
          // bloque l'apply. Un SEUL binaire (labctl dispatch-gate) — pas de
          // ré-implémentation shell du check ITSM : le stage échoue AVANT Apply,
          // et la couche apply-uac le rejoue fail-closed dans le process d'apply.
          sh '"$WORKSPACE/labctl" dispatch-gate --repo governance --env prod --tenant "$APPLY_TENANT"'
        }
      }
    }
    stage('Apply PROD — apply-uac --env prod (admin direct, secrets Vault)') {
      steps {
        dir(env.GIT_SUBDIR) {
          withCredentials([string(credentialsId: 'vault-ci-secret-id', variable: 'VAULT_SECRET_ID')]) {
            sh '''
              set +x          # NEVER echo: secret_id, vault token, OAuth token
              set -eu
              # Login Vault mutualisé (ci/lib/vault-login.sh) : NOMINATIF si l'opérateur
              # a saisi VAULT_USER + son mot de passe, sinon repli AppRole — identité de
              # MACHINE, comportement historique inchangé. La lib annonce à voix haute
              # laquelle a servi : un log prod qui ne distingue pas « acte d'un humain »
              # de « acte d'une machine » ruine l'imputabilité recherchée.
              . ci/lib/vault-login.sh
              # Trap armé AVANT le login : révoque + prouve la mort du token même si
              # l'apply échoue. Un seul trap EXIT existe en shell, d'où vault_tmpfile
              # pour les fichiers sensibles de ce bloc (ils meurent avec lui).
              trap vault_trap_revoke EXIT
              vault_login_any || exit 1

              # Lectures KV par la lib : token en fichier d'en-têtes (jamais en argv,
              # contrairement à un -H "X-Vault-Token: $TOK") et parse JSON plutôt que
              # sed — un sed sur du JSON casse dès qu'un champ contient une quote.
              CI_SECRET=$(vault_read secret/data/stoa/ci ciApplierSecret)
              OPENSEARCH_PASSWORD=$(vault_read secret/data/stoa/opensearch adminPassword)
              export OPENSEARCH_PASSWORD

              # Jeton du compte de service : le client_secret part par le CORPS de la
              # requête via printf (builtin, donc sans process ni argv) — un
              # -d client_secret="$S" l'exposerait dans ps.
              KCRESP=$(vault_tmpfile kc-resp.json)
              printf 'client_id=ci-applier\\ngrant_type=client_credentials\\nclient_secret=%s\\n' "$CI_SECRET" \\
                | form_post_no_argv "$KCRESP" http://keycloak:8080/realms/stoa-lab/protocol/openid-connect/token >/dev/null
              unset CI_SECRET
              TOKFILE=$(vault_tmpfile labctl-token)
              python3 -c 'import json,sys;t=json.load(open(sys.argv[1]))["access_token"];open(sys.argv[2],"w").write(t)' \\
                "$KCRESP" "$TOKFILE"
              [ -s "$TOKFILE" ] || { echo 'no CI token'; exit 1; }

              # Admin DIRECT du wM réel ; creds Basic résolus depuis Vault
              # (secret/stoa/gateways/webmethods) via le token éphémère — VAULT_TOKEN_FILE
              # est déjà exporté par la lib.
              LABCTL_TOKEN_FILE="$TOKFILE" "$WORKSPACE/labctl" apply-uac \
                --repo governance --env prod --tenant "$APPLY_TENANT" -f envs/prod/targets.cluster.yaml
            '''
          }
        }
      }
    }
    stage('Smoke test — data-plane prod') {
      steps {
        dir(env.GIT_SUBDIR) {
          sh '''
            set -eu
            # Même logique que scripts/phase3-identity-demo.sh, côté agent :
            #   1. catalogue : l'API est servie par le gateway (get apis)
            #   2. barrière data-plane : sans token -> 401 (policy enforce)
            "$WORKSPACE/labctl" get apis -f envs/prod/targets.cluster.yaml
            CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 \
              "http://webmethods-real:5555/gateway/accounts-read/1.0.0/accounts")
            echo "data-plane sans token -> HTTP $CODE"
            [ "$CODE" = 401 ] || { echo "SMOKE KO: attendu 401 sans token (reçu $CODE)"; exit 1; }
            echo 'SMOKE OK — API servie, barrière OAuth2 active.'
          '''
        }
      }
    }
  }
  post {
    success { echo '✓ PROD convergée depuis une promotion approuvée (4-yeux + ITSM + commit pinné).' }
    failure { echo '✗ pipeline prod KO — AUCUN dispatch n\'a lieu si le gate échoue.' }
  }
}

// É0 — clone du repo governance avec auth Git OPTIONNELLE (même convention que
// ci/Jenkinsfile) : GIT_CREDENTIALS_ID vide -> anonyme (PoC) ; posé -> creds via
// GIT_ASKPASS éphémère (jamais URL/argv/log). Clone COMPLET (ResolvePinned).
def cloneGovernance() {
  def clone = {
    sh '''
      set -eu
      rm -rf governance
      if [ -n "${GIT_USER:-}" ]; then
        ASKPASS="$WORKSPACE/.git-askpass"
        printf '#!/bin/sh\\ncase "$1" in Username*) printf %%s "$GIT_USER" ;; *) printf %%s "$GIT_PASS" ;; esac\\n' > "$ASKPASS"
        chmod 700 "$ASKPASS"
        GIT_ASKPASS="$ASKPASS" GIT_TERMINAL_PROMPT=0 git clone "$GOVERNANCE_GIT_URL" governance
        rm -f "$ASKPASS"
      else
        GIT_TERMINAL_PROMPT=0 git clone "$GOVERNANCE_GIT_URL" governance
      fi
    '''
  }
  if (env.GIT_CREDENTIALS_ID?.trim()) {
    withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID,
                                      usernameVariable: 'GIT_USER',
                                      passwordVariable: 'GIT_PASS')]) { clone() }
  } else {
    clone()
  }
}
