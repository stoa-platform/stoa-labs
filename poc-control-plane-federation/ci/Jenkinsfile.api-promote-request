// Jenkinsfile.api-promote-request — formulaire « promouvoir une API » (G3).
// Ouvre une PR portant apis/<name>.deploy.<TO_ENV>.yaml sur le dépôt d'ÉQUIPE.
// NE DÉPLOIE RIEN : la décision est le merge de cette PR (ADR-081).
//
// Le merge de la PR promote/<name>-<env> déclenche team-promote (G5) : pause
// nominative, garde d'identité, pin de l'archive par sha256, apply réel.
// (Une version antérieure de cet en-tête décrivait l'époque — G3 — où ce
// merge ne déclenchait rien ; périmée depuis G5, corrigée le 2026-08-28.)
//
// ⚠ Les listes FROM_ENV/TO_ENV sont écrites À LA MAIN, et c'est documenté comme
// tel : un bloc `parameters {}` déclaratif est évalué à la POSE du job, hors
// workspace — il n'a aucun accès au clone governance, donc il ne peut pas
// dériver d'environments.yaml.
//
// ⚠ ET CE SONT DEUX LISTES INDÉPENDANTES : chaque valeur est un palier légal,
// mais le FORMULAIRE n'empêche pas d'en composer une paire illégale (dev→prod,
// rec→homol). C'est le SCRIPT qui la refuse, à la demande, par CHAINE_INVALIDE.
// L'analogie avec ci/Jenkinsfile.selfservice:34 s'arrête là : celui-ci ne porte
// qu'UN seul paramètre d'environnement, donc aucune paire à incohérer.
// forgeCreds() — la liste withCredentials du TYPE declare par le site.
// Dans les deux cas, le shell voit les MEMES noms : FORGE_SECRET (le secret) et
// FORGE_USER (l'utilisateur, vide avec un jeton). Les scripts acceptent
// FORGE_SECRET, avec GITEA_TOKEN toujours honore comme alias historique.
// 2026-09-10 : FAIL-CLOSED, et la console DIT ce qu'elle lie. Mesure chez un
// client (copie du Jenkinsfile mise a jour a la main, sans le knob) : toute
// valeur hors {secret-text, username-password} retombait EN SILENCE sur secret
// text, et Jenkins refusait alors le credential user/mot de passe par un
// message qui accuse le credential, jamais le knob — « tous les types donnent
// le meme message ». Le refus se nomme AVANT tout binding ; l'identifiant du
// credential n'est pas un secret, il s'ecrit.
def forgeCreds() {
  def kind = "${env.FORGE_CRED_KIND ?: ''}".trim()
  if (kind == 'username-password') {
    echo "credential de la forge : '${env.GITEA_CREDENTIALS_ID}' lie en username-password (FORGE_USER + FORGE_SECRET)"
    return [usernamePassword(credentialsId: env.GITEA_CREDENTIALS_ID,
                             usernameVariable: 'FORGE_USER', passwordVariable: 'FORGE_SECRET')]
  }
  if (kind == 'secret-text') {
    echo "credential de la forge : '${env.GITEA_CREDENTIALS_ID}' lie en secret-text (FORGE_SECRET)"
    return [string(credentialsId: env.GITEA_CREDENTIALS_ID, variable: 'FORGE_SECRET')]
  }
  error("REFUS: FORGE_CRED_KIND_INVALIDE — FORGE_CRED_KIND='${kind}' : attendu secret-text (jeton) ou username-password (couple). Rien n a ete lie. Poser la globale Jenkins FORGE_CRED_KIND (setup-jenkins-globals.sh).")
}

pipeline {
  agent any
  options { disableConcurrentBuilds() }

  // ── POINTS DE CONFIG CLIENT ────────────────────────────────────────────────
  // Motif `env.X ?: défaut`, IDENTIQUE aux Jenkinsfile frères : le MÊME fichier
  // sert le lab et le client, sans fork. Sans ce bloc, l'ID de credential serait
  // un littéral Groovy en dur et un client dont le credential porte un autre nom
  // devrait forker le Jenkinsfile — précisément ce que ce motif existe pour
  // éviter. Les défauts reproduisent ceux que le script applique déjà lui-même.
  //
  // ⚠ `gitea-provision-token` est le SEUL credential réellement provisionné
  // (scripts/setup-provision-request-job.sh) et celui qu'utilisent les cinq
  // autres Jenkinsfile qui parlent à Gitea. Un ID inventé fait échouer le build
  // sur CredentialNotFoundException, et aucune épreuve hors ligne ne le voit.
  environment {
    // Préfixe du livrable DANS le dépôt (2026-09-03) : le seul endroit qui le
    // nomme. « . » = le livrable EST la racine (une valeur VIDE ne traverse pas
    // Jenkins : elle arrive absente et reprendrait ce défaut).
    GIT_SUBDIR           = "${env.GIT_SUBDIR ?: 'poc-control-plane-federation'}"
    GIT_HOST             = "${env.GIT_HOST ?: 'http://gitea:3000'}"
    GIT_REPO             = "${env.GIT_REPO ?: 'ci/stoa-labs'}"
    // LE VISAGE DE LA FORGE — SANS DÉFAUT DE SITE, délibérément (2026-09-12).
    // `gitea` a été le défaut de ce knob, et c'était un faux filet : un client
    // dont la globale n'est pas posée voyait la chaîne parler Gitea à GitLab
    // (302 vers /users/sign_in, corps HTML, FORGE_ILLISIBLE — 2026-09-09), et le
    // refus fail-closed de l'autorité (FORGE_KIND_REQUIS) ne pouvait JAMAIS se
    // déclencher puisque c'est le pipeline qui fournissait la valeur. Repli VIDE
    // ⇒ globale manquante = refus. Elle est donc REQUISE (setup-jenkins-globals.sh).
    // FORGE_API_AUTH / FORGE_API_BASE : repli vide aussi — absents, la lib dérive
    // l'en-tête d'auth du visage et la base d'API de GIT_HOST.
    FORGE_KIND           = "${env.FORGE_KIND ?: ''}"
    FORGE_API_AUTH       = "${env.FORGE_API_AUTH ?: ''}"
    FORGE_API_BASE       = "${env.FORGE_API_BASE ?: ''}"
    GITEA_CREDENTIALS_ID = "${env.GITEA_CREDENTIALS_ID ?: 'gitea-provision-token'}"
  }

  parameters {
    string(name: 'TEAM',           defaultValue: '', description: 'Équipe propriétaire')
    string(name: 'API_NAME',       defaultValue: '', description: "Nom de l'API")
    choice(name: 'FROM_ENV',       choices: ['dev', 'rec', 'int', 'homol'], description: 'Palier source')
    choice(name: 'TO_ENV',         choices: ['rec', 'int', 'homol', 'prod'], description: "Palier d'arrivée")
    string(name: 'MESSAGE',        defaultValue: '', description: "Message d'audit (obligatoire)")
    string(name: 'CHANGE_REF',     defaultValue: '', description: 'Référence de changement ITSM (selon la porte)')
    string(name: 'PV_REF',         defaultValue: '', description: 'Référence de PV de recette (selon la porte)')
    string(name: 'ARCHIVE_SHA256', defaultValue: '', description: "FACULTATIF. Vide : lu sur la branche de base du dépôt d'équipe (manifeste épinglé) depuis dev, hérité du palier source au-delà. Renseigné : depuis dev il gagne avec avertissement (re-promotion d'une archive antérieure) ; au-delà, une contradiction avec la source est refusée (DIGEST_CONTREDIT_SOURCE).")
    // DEBUG (opt-in, L4) : trace détaillée sous STOA_DEBUG, aucun secret exposé — la case ALLUME le mode, elle n'éteint jamais la globale.
    booleanParam(name: 'DEBUG',  defaultValue: false, description: "Trace détaillée (appels, codes HTTP, erreurs redactées) — aucun secret exposé.")
  }
  stages {
    stage('Demande de promotion') {
      steps {
        // Les paramètres de build subissent EnvVars.resolve : withEnv est
        // obligatoire pour qu'ils arrivent intacts au script (fait mesuré,
        // cf. mémoire ci-jenkinsfile-refactor).
        withCredentials(forgeCreds()) {
          withEnv([
            "TEAM=${params.TEAM}", "API_NAME=${params.API_NAME}",
            "FROM_ENV=${params.FROM_ENV}", "TO_ENV=${params.TO_ENV}",
            "MESSAGE=${params.MESSAGE}", "CHANGE_REF=${params.CHANGE_REF}",
            "PV_REF=${params.PV_REF}", "ARCHIVE_SHA256=${params.ARCHIVE_SHA256}",
            "PROMOTED_BY=${env.BUILD_USER_ID ?: 'ci'}",
          ]) {
            dir(env.GIT_SUBDIR) {
              sh 'if [ "${DEBUG:-false}" = "true" ]; then export STOA_DEBUG=1; fi; bash scripts/api-promote-request.sh'
            }
          }
        }
      }
    }
  }
}
